local function CreateSectionHeader(parent, title, yOffset)
	local label = Instance.new("TextLabel")
	label.Parent = parent
	label.Size = UDim2.new(1, -10, 0, 22)
	label.Position = UDim2.new(0, 5, 0, yOffset)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = "— " .. string.upper(title) .. " —"
	label.TextColor3 = Color3.fromRGB(57, 255, 20)
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	return label
end

local function CreateToggle(parent, title, defaultState, position, callback)
	local btn = Instance.new("TextButton")
	btn.Parent = parent
	btn.Position = position
	btn.Size = UDim2.new(0.32, -4, 0, 36)
	btn.BackgroundColor3 = defaultState and Color3.fromRGB(35, 140, 20) or Color3.fromRGB(25, 32, 25)
	btn.BorderSizePixel = 0
	btn.Font = Enum.Font.GothamSemibold
	btn.Text = title .. (defaultState and " : ON" or " : OFF")
	btn.TextColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 200, 180)
	btn.TextSize = 11

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = defaultState and Color3.fromRGB(60, 255, 25) or Color3.fromRGB(45, 60, 45)
	stroke.Thickness = 1
	stroke.Parent = btn

	local state = defaultState
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.BackgroundColor3 = state and Color3.fromRGB(35, 140, 20) or Color3.fromRGB(25, 32, 25)
		btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 200, 180)
		stroke.Color = state and Color3.fromRGB(60, 255, 25) or Color3.fromRGB(45, 60, 45)
		btn.Text = title .. (state and " : ON" or " : OFF")
		if callback then callback(state, btn) end
	end)

	return btn
end

local function CreateActionBtn(parent, title, position, callback)
	local btn = Instance.new("TextButton")
	btn.Parent = parent
	btn.Position = position
	btn.Size = UDim2.new(0.32, -4, 0, 36)
	btn.BackgroundColor3 = Color3.fromRGB(32, 42, 32)
	btn.BorderSizePixel = 0
	btn.Font = Enum.Font.GothamBold
	btn.Text = title
	btn.TextColor3 = Color3.fromRGB(240, 255, 240)
	btn.TextSize = 11

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(60, 80, 60)
	stroke.Thickness = 1
	stroke.Parent = btn

	btn.MouseButton1Click:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(57, 255, 20)}):Play()
		task.delay(0.15, function()
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(32, 42, 32)}):Play()
		end)
		if callback then callback(btn) end
	end)

	return btn
end

