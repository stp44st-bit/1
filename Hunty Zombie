				hl.FillColor = z.IsBoss and Color3.fromRGB(255, 50, 50) or ChamsColors[State.ChamsColorIndex]
				hl.FillTransparency = 0.5
				hl.OutlineColor = z.IsBoss and Color3.fromRGB(255, 215, 0) or ChamsColors[State.ChamsColorIndex]
				hl.OutlineTransparency = 0
				hl.Enabled = State.Chams
				hl.Parent = model

				ZombieESPStore[model] = {Billboard = bb, Highlight = hl, HPLabel = hpLabel}
			else
				local store = ZombieESPStore[model]
				if store.Billboard then
					store.Billboard.Enabled = State.ZombieESP
					if store.HPLabel and myPos then
						local dist = math.floor((root.Position - myPos).Magnitude * 0.28)
						store.HPLabel.Text = dist .. "m | HP: " .. math.floor(hum.Health)
					end
				end
				if store.Highlight then
					store.Highlight.Enabled = State.Chams
					store.Highlight.FillColor = z.IsBoss and Color3.fromRGB(255, 50, 50) or ChamsColors[State.ChamsColorIndex]
				end
			end
		end
	end
end)

