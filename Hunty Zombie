local VIM_Debounce = false
local function TriggerAutoAttack(targetZombie)
	task.spawn(function()
		pcall(function()
			local myChar = LocalPlayer.Character
			if not myChar then return end

			local cx = (Camera.ViewportSize.X > 0) and (Camera.ViewportSize.X / 2) or 500
			local cy = (Camera.ViewportSize.Y > 0) and (Camera.ViewportSize.Y / 2) or 300

			-- Method 1: Precision Viewport Mouse Click with Cycle
			if VirtualInputManager and not VIM_Debounce then
				VIM_Debounce = true
				task.spawn(function()
					pcall(function()
						VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
						task.wait(0.01)
						VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
					end)
					task.wait(0.02)
					VIM_Debounce = false
				end)
			end

			-- Method 2: mouse1click / mouse1press executor function
			if mouse1click then
				mouse1click()
			elseif mouse1press and mouse1release then
				mouse1press()
				task.wait(0.01)
				mouse1release()
			end

			-- Method 3: VirtualUser Button1Down
			if VirtualUser then
				VirtualUser:CaptureController()
				VirtualUser:Button1Down(Vector2.new(cx, cy))
				task.wait(0.01)
				VirtualUser:Button1Up(Vector2.new(cx, cy))
			end

			-- Method 4: Tool Activation & Tool Remotes
			local tool = myChar:FindFirstChildOfClass("Tool")
			if tool then
				tool:Activate()
				for _, v in ipairs(tool:GetDescendants()) do
					if v:IsA("RemoteEvent") then
						if targetZombie and targetZombie.Root then
							v:FireServer(targetZombie.Root, targetZombie.Root.Position)
						else
							v:FireServer()
						end
					end
				end
			else
				local bpTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
				if bpTool and myChar:FindFirstChildOfClass("Humanoid") then
					myChar.Humanoid:EquipTool(bpTool)
				end
			end

			-- Removed Method 5 (Direct Remote Firing) to prevent triggering Anti-Cheat honeypots
		end)
	end)
end

local function TriggerSkillsAndReload()
	task.spawn(function()
		pcall(function()
			if VirtualInputManager then
				if State.AutoSkills then
					for _, key in ipairs({Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.F}) do
						VirtualInputManager:SendKeyEvent(true, key, false, game)
