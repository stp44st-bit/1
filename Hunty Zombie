-- ==================== AUTO FARM & ANTI-FLING MOB VACUUM ENGINE ====================
task.spawn(function()
	while not IsClosed do
		if State.AutoFarm then
			pcall(function()
				local myChar = LocalPlayer.Character
				local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
				if myHrp then
					-- BodyVelocity Stabilizer to completely prevent falling / rubberbanding
					if not FarmBV or FarmBV.Parent ~= myHrp then
						if FarmBV then FarmBV:Destroy() end
						FarmBV = Instance.new("BodyVelocity")
						FarmBV.MaxForce = Vector3.new(9e5, 9e5, 9e5)
						FarmBV.Velocity = Vector3.zero
						FarmBV.Parent = myHrp
					end

					local target = GetClosestZombie(math.huge, State.TargetBossOnly)
					-- Prevent teleporting to voided targets to avoid Anti-Void infinite loop
					if target and target.Root and target.Root.Parent and target.Root.Position.Y > -40 then
						local targetPos
						if State.FarmMode == "Above" then
							targetPos = target.Root.CFrame * CFrame.new(0, State.FarmHeight, 0)
						elseif State.FarmMode == "Behind" then
							targetPos = target.Root.CFrame * CFrame.new(0, 1, 6)
						elseif State.FarmMode == "Under" then
							targetPos = target.Root.CFrame * CFrame.new(0, -State.FarmHeight, 0)
						else
							targetPos = target.Root.CFrame * CFrame.new(0, 2, 14)
						end

						-- Position character smoothly and ALWAYS face the target
						myHrp.CFrame = CFrame.lookAt(targetPos.Position, target.Root.Position)
						myHrp.AssemblyLinearVelocity = Vector3.zero

						-- Anti-Fling Bring Mobs / Vacuum Mode (Clustered on Target)
						if State.BringMobs then
							for _, z in ipairs(GetZombies()) do
								if z.Model and z.Model.Parent and z.Root and z.Root.Parent and z.Model ~= target.Model then
									if not z.Root.Anchored then -- Skip anchored mobs (bosses/statues)
										local curHp, _ = GetHealthInfo(z.Model, z.Model:FindFirstChildOfClass("Humanoid"))
										if curHp > 0 then
											z.Root.CanCollide = false
											z.Root.CFrame = target.Root.CFrame * CFrame.new(math.random(-2, 2), 0, math.random(-2, 2))
											z.Root.AssemblyLinearVelocity = Vector3.zero
										end
									end
								end
							end
						end

						-- Trigger Attack & Skills
						if State.AutoAttack then
							TriggerAutoAttack(target)
						end
						TriggerSkillsAndReload()
					end
				end
			end)
		else
			if FarmBV then FarmBV:Destroy() FarmBV = nil end
		end
		task.wait(State.AttackInterval)
	end
end)

-- ==================== TARGETED AUTO DROP COLLECTOR ====================
task.spawn(function()
	while not IsClosed do
		if State.AutoLoot then
			pcall(function()
				local myChar = LocalPlayer.Character
				local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
				if myHrp then
					local myPos = myHrp.Position
					local lootCandidates = {}

					-- Check specialized drop containers first
					for _, cName in ipairs({"Drops", "Loot", "Pickups", "Items", "Debris", "Rewards"}) do
						local c = workspace:FindFirstChild(cName)
						if c then
							for _, obj in ipairs(c:GetDescendants()) do
								if obj:IsA("BasePart") then table.insert(lootCandidates, obj) end
							end
						end
					end

					-- Check workspace direct children
					for _, obj in ipairs(workspace:GetChildren()) do
						if obj:IsA("BasePart") then
							table.insert(lootCandidates, obj)
						elseif obj:IsA("Model") and not obj:FindFirstChildOfClass("Humanoid") then
							local p = obj:FindFirstChildWhichIsA("BasePart")
							if p then table.insert(lootCandidates, p) end
						end
					end

					for _, part in ipairs(lootCandidates) do
						if part and part.Parent then
							local name = (part.Name .. " " .. (part.Parent and part.Parent.Name or "")):lower()
							if name:find("coin") or name:find("drop") or name:find("loot") or name:find("crate") or name:find("ammo") or name:find("medkit") or name:find("cash") or name:find("pickup") or name:find("reward") then
								local dist = (part.Position - myPos).Magnitude
								if dist <= State.LootRadius then
									local prompt = part:FindFirstChildOfClass("ProximityPrompt") or (part.Parent and part.Parent:FindFirstChildOfClass("ProximityPrompt"))
									if prompt and fireproximityprompt then
										fireproximityprompt(prompt)
									end
									part.CFrame = myHrp.CFrame
									part.CanCollide = false
									firetouchinterest(myHrp, part, 0)
									task.wait()
									firetouchinterest(myHrp, part, 1)
								end
							end
						end
					end
				end
			end)
		end
		task.wait(0.25)
	end
end)

