local function GetZombies()
	local zombies = {}
	local candidates = {}

	for _, name in ipairs({"Zombies", "Mobs", "Enemies", "Monsters", "Entities", "NPCs", "WaveZombies"}) do
		local folder = workspace:FindFirstChild(name)
		if folder then
			for _, c in ipairs(folder:GetChildren()) do table.insert(candidates, c) end
		end
	end

	for _, c in ipairs(workspace:GetChildren()) do
		if c:IsA("Model") and c ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(c) then
			table.insert(candidates, c)
		end
	end

	for _, model in ipairs(candidates) do
		if model:IsA("Model") then
			local hum = model:FindFirstChildOfClass("Humanoid")
			local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Head")
			if hum and hrp and hum.Health > 0 then
				local isPlayer = Players:GetPlayerFromCharacter(model)
				if not isPlayer then
					table.insert(zombies, {
						Model = model,
						Humanoid = hum,
						Root = hrp,
						IsBoss = model.Name:lower():find("boss") or model.Name:lower():find("giant") or model.Name:lower():find("brute") or hum.MaxHealth > 500
					})
				end
			end
		end
	end
	return zombies
end

local function GetClosestZombie(maxDist, bossOnly)
	maxDist = maxDist or math.huge
	local closest, closestDist = nil, maxDist
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	local myPos = myChar.HumanoidRootPart.Position

	for _, z in ipairs(GetZombies()) do
		if not bossOnly or z.IsBoss then
			local dist = (z.Root.Position - myPos).Magnitude
			if dist < closestDist then
				closestDist = dist
				closest = z
			end
		end
	end
	return closest, closestDist
end

local function GetClosestZombieToMouse(fovLimit)
	fovLimit = fovLimit or State.AimFOV
	local closest, closestDist = nil, fovLimit
	local mousePos = Vector2.new(Mouse.X, Mouse.Y)

	for _, z in ipairs(GetZombies()) do
		local targetPart = z.Model:FindFirstChild(State.AimPart) or z.Root
		if targetPart then
			local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
			if onScreen then
				local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
				if dist < closestDist then
					closestDist = dist
					closest = z
				end
			end
		end
	end
	return closest
end

local function AttackEquipped()
	pcall(function()
		local char = LocalPlayer.Character
		if not char then return end
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then
			tool:Activate()
			for _, v in ipairs(tool:GetDescendants()) do
				if v:IsA("RemoteEvent") then
					v:FireServer()
				end
			end
		else
			local bpTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
			if bpTool and char:FindFirstChildOfClass("Humanoid") then
				char.Humanoid:EquipTool(bpTool)
			end
		end
	end)
end

