local function GetHealthInfo(model, hum)
	if hum and typeof(hum) == "Instance" and hum:IsA("Humanoid") then
		return math.max(hum.Health, 0), math.max(hum.MaxHealth, 1)
	end
	local hObj = model:FindFirstChild("Health") or model:FindFirstChild("HP")
	if hObj and (hObj:IsA("NumberValue") or hObj:IsA("IntValue") or hObj:IsA("DoubleConstrainedValue")) then
		return math.max(hObj.Value, 0), 100
	end
	local hAttr = model:GetAttribute("Health") or model:GetAttribute("HP") or model:GetAttribute("health") or model:GetAttribute("hp")
	if typeof(hAttr) == "number" then
		local maxAttr = model:GetAttribute("MaxHealth") or model:GetAttribute("MaxHP") or 100
		return math.max(hAttr, 0), math.max(maxAttr, 1)
	end
	return 100, 100
end

local function FindRootPart(model)
	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("Head")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Hitbox")
		or model:FindFirstChild("Root")
		or model.PrimaryPart
		or model:FindFirstChildWhichIsA("BasePart")
end

local function IsZombieCandidate(model)
	if not model or not model:IsA("Model") then return false end
	if model == LocalPlayer.Character then return false end
	if Players:GetPlayerFromCharacter(model) then return false end

	local hum = model:FindFirstChildOfClass("Humanoid")
	local curHp, maxHp = GetHealthInfo(model, hum)
	if curHp <= 0 then return false end

	local root = FindRootPart(model)
	if not root or not root.Parent then return false end

	local name = model.Name:lower()
	local parentName = model.Parent and model.Parent.Name:lower() or ""

	local isMatch = hum ~= nil
		or name:find("zombie") or name:find("mob") or name:find("enemy") or name:find("boss") or name:find("monster") or name:find("crawler") or name:find("brute")
		or parentName:find("zombie") or parentName:find("mob") or parentName:find("enemy") or parentName:find("monster") or parentName:find("live") or parentName:find("entity")

	if isMatch then
		local isBoss = name:find("boss") or name:find("giant") or name:find("brute") or name:find("mutant") or maxHp > 500
		return true, root, hum, curHp, maxHp, isBoss
	end
	return false
end

local function ScanAllZombies()
	local results = {}
	local candidates = {}

	for _, folderName in ipairs({"Mobs", "Zombies", "Enemies", "Monsters", "Entities", "NPCs", "Live", "CurrentMap", "GameFolder", "Map", "Wave", "Spawns", "World"}) do
		local folder = workspace:FindFirstChild(folderName)
		if folder then
			for _, obj in ipairs(folder:GetDescendants()) do
				if obj:IsA("Model") then table.insert(candidates, obj) end
			end
		end
	end

	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("Model") then table.insert(candidates, obj) end
	end

	local seen = {}
	for _, model in ipairs(candidates) do
		if not seen[model] then
			seen[model] = true
			local valid, root, hum, curHp, maxHp, isBoss = IsZombieCandidate(model)
			if valid and root and root.Parent then
				table.insert(results, {
					Model = model,
					Root = root,
					Humanoid = hum,
					CurrentHP = curHp,
					MaxHP = maxHp,
					IsBoss = isBoss
				})
			end
		end
	end

	CachedZombies = results
	LastScanTime = tick()
	return results
end

local function GetZombies()
	if tick() - LastScanTime > 0.3 then
		return ScanAllZombies()
	end
	return CachedZombies
end

-- Instant Live Health Check for Target Acquisition
local function GetClosestZombie(maxDist, bossOnly)
	maxDist = maxDist or math.huge
	local closest, closestDist = nil, maxDist
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
	local myPos = myChar.HumanoidRootPart.Position

	for _, z in ipairs(GetZombies()) do
		if z.Model and z.Model.Parent and z.Root and z.Root.Parent and (not bossOnly or z.IsBoss) then
			local hum = z.Model:FindFirstChildOfClass("Humanoid")
			local curHp, _ = GetHealthInfo(z.Model, hum)
			if curHp > 0 then
				local dist = (z.Root.Position - myPos).Magnitude
				if dist < closestDist then
					closestDist = dist
					closest = z
				end
			end
		end
	end
	return closest, closestDist
end

local function GetClosestZombieToMouse(fovLimit)
	fovLimit = fovLimit or State.AimFOV
	local closest, closestDist = nil, fovLimit
	local mousePos = Vector2.new(Mouse.X, Mouse.Y)

	for _, z in ipairs(GetZombies()) do
		if z.Model and z.Model.Parent and z.Root and z.Root.Parent then
			local hum = z.Model:FindFirstChildOfClass("Humanoid")
			local curHp, _ = GetHealthInfo(z.Model, hum)
			if curHp > 0 then
				local targetPart = z.Model:FindFirstChild(State.AimPart) or z.Root
				if targetPart then
					local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
					if onScreen then
						local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
						if dist < closestDist then
							closestDist = dist
							closest = z
						end
					end
				end
			end
		end
	end
	return closest
end

