RunService:BindToRenderStep("MeeHubAimbot_HZ", Enum.RenderPriority.Camera.Value + 1, function()
	if IsClosed then return end

	-- Aimbot Manual Lock
	if State.AimAssist and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local target = GetClosestZombieToMouse(State.AimFOV)
		if target and target.Model then
			local aimPart = target.Model:FindFirstChild(State.AimPart) or target.Root
			if aimPart and (aimPart.Position - Camera.CFrame.Position).Magnitude > 0.5 then
				local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, aimPart.Position)
				Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, State.AimSmoothness)
			end
		end
	end

	-- Auto Farm Camera Tracking
	if State.AutoFarm then
		local target = GetClosestZombie(math.huge, State.TargetBossOnly)
		if target and target.Root and target.Root.Parent then
			local aimPart = target.Model:FindFirstChild("Head") or target.Root
			if aimPart and (aimPart.Position - Camera.CFrame.Position).Magnitude > 0.5 then
				Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, aimPart.Position)
			end
		end
	end
end)

