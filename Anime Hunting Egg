	local function hasWord(t, list)
		for _, w in ipairs(list) do
			if string.find(t, w, 1, true) then return true end
		end
		return false
	end
	local function shown(g)
		if g.AbsoluteSize.X < 3 then return false end
		local o = g
		while o and not o:IsA("LayerCollector") do
			if o:IsA("GuiObject") and not o.Visible then return false end
			o = o.Parent
		end
		return o ~= nil and not (o:IsA("ScreenGui") and not o.Enabled)
	end
	local function btnText(b)
		local t = string.lower(b.Name .. " " .. (b:IsA("TextButton") and b.Text or ""))
