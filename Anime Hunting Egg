	---------------- replay (end dialog: a replay button next to a home / leave button)
	local function findReplayButton()
		local lb = resolveBtn(L.replayBtn)
		if lb and shown(lb) then return lb, "learned" end
		local pg = LP:FindFirstChildOfClass("PlayerGui")
		if not pg then return nil end
		for _, b in ipairs(pg:GetDescendants()) do
			if b:IsA("GuiButton") and shown(b) then
				local t = btnText(b)
				if hasWord(t, REPLAY_WORDS) and not hasWord(t, LEAVE_WORDS) and not hasWord(t, REPLAY_BLOCK)
					and not hasWord(string.lower(b:GetFullName()), REPLAY_BLOCK) and dialogOf(b) then
					return b, "found"
				end
			end
		end
		return nil
	end

	local hideDialog = function(b)
		local dlg = dialogOf(b) or topFrame(b)
		if dlg and dlg:IsA("GuiObject") and dlg.Visible then
			dlg.Visible = false
			rep.hidden = dlg
			note("hid end dialog: " .. dlg:GetFullName())
		end
	end

	local function fireReplayRemote()
		local c = L.replayCall
		if not (c and c.remote and c.remote.Parent) then return false end
		local a = c.args
		task.spawn(function()
			pcall(function()
				if c.method == "FireServer" then c.remote:FireServer(table.unpack(a, 1, a.n))
				else c.remote:InvokeServer(table.unpack(a, 1, a.n)) end
			end)
		end)
		note("replay remote: " .. tostring(c.name))
		return true
	end

	local busyReplay = false
	local function replayOnce(b, how)
		busyReplay = true
		local _, hrp = getChar()
		local startPos = hrp and hrp.Position
		local moved = function()
			local _, h2 = getChar()
			return startPos and h2 and (h2.Position - startPos).Magnitude > 300
		end
		local ok, res = pcall(pressUntilGone, b, "replay " .. b.Name, moved)
		if ok and res then
			stat.replays = stat.replays + 1
			rep.why = "replay #" .. stat.replays .. " (" .. how .. " button, " .. res .. ")"
			if b.Parent and shown(b) then hideDialog(b) end
		elseif fireReplayRemote() then
			stat.replays = stat.replays + 1
			rep.why = "button did not respond -> replay via learned remote"
			task.wait(2)
			if b.Parent and shown(b) then hideDialog(b) end
		else
			rep.why = "could not press " .. b.Name .. " - see Save Log / Popup Scan"
		end
		status = rep.why
		rep.last = os.clock()
		busyReplay = false
	end

	local function doReplay() -- test button
		local b, how = findReplayButton()
		if b then
			task.spawn(replayOnce, b, how)
			return "button " .. b.Name
		end
		if fireReplayRemote() then return "remote " .. tostring(L.replayCall.name) end
		return nil
	end

	-- BossRoom_1..8: Active true -> false while you stand in it = that fight finished (used only for the learned-remote fallback)
	local rooms, roomsAt = {}, -100
	local function myRoom(pos)
		if os.clock() - roomsAt > 10 then
			roomsAt = os.clock()
			rooms = {}
			for _, r in ipairs(Workspace:GetChildren()) do
				if string.sub(r.Name, 1, 9) == "BossRoom_" and typeof(r:GetAttribute("Center")) == "Vector3" then rooms[#rooms + 1] = r end
			end
		end
		for _, r in ipairs(rooms) do
			local c = r:GetAttribute("Center")
			if flat(c, pos) <= (r:GetAttribute("Radius") or 142) * 1.3 and math.abs(pos.Y - c.Y) < 700 then return r end
		end
		return nil
	end

	task.spawn(function()
		local seenAt, seenBtn = nil, nil
		while running do
			local now = os.clock()
			local _, hrp = getChar()
			if hrp then
				local room = myRoom(hrp.Position)
				local act = (room and room:GetAttribute("Active") == true) or false
				if room == rep.room and rep.roomActive and not act then rep.endedAt = now end
				if act then rep.endedAt = nil end
				rep.room, rep.roomActive = room, act
			end
			-- a dialog hidden by us comes back when the game shows it again next round
			if rep.hidden and rep.hidden.Parent and now - rep.last > 8 then
				rep.hidden.Visible = true
				rep.hidden = nil
			end
			if cfg.AutoReplay and not busyReplay then
				local b, how = findReplayButton()
				if b then
					rep.cand = b:GetFullName()
					if b ~= seenBtn then seenBtn, seenAt = b, now end
					local lbShown = (how == "learned")
					if rep.lbShown and lbShown then
						rep.why = "you pressed it yourself this round"
					elseif userBusy() then
						rep.why = "you are pressing things - replay paused"
					elseif now - seenAt < cfg.ReplayDelay then
						rep.why = string.format("replay button seen, pressing in %.1f s", cfg.ReplayDelay - (now - seenAt))
					elseif now - rep.last > 6 then
						rep.why = "pressing " .. b.Name .. " ..."
						task.spawn(replayOnce, b, how)
					else
						rep.why = "replay button back on screen, pressing again soon"
					end
				else
					seenBtn, seenAt = nil, nil
					rep.lbShown = false
					if rep.endedAt and L.replayCall and not rep.remoteDone and now - rep.endedAt > cfg.ReplayDelay + 3 then
						rep.remoteDone = true
						if fireReplayRemote() then
							stat.replays = stat.replays + 1
							rep.why = "no replay button seen -> learned remote"
							rep.last = now
						end
					elseif not rep.endedAt then
						rep.remoteDone = false
						rep.why = rep.roomActive and "in boss room" or "waiting for the replay / home dialog"
					end
				end
			elseif not cfg.AutoReplay then
				rep.why = "auto replay off"
			end
			task.wait(0.5)
		end
	end)

	-- everything a mode needs you to find: dumps names / paths / attributes / on-screen text to a file + clipboard
	local function modeScan()
		local out = { "-- milk mode scan  " .. os.date("%H:%M:%S"), "-- workspace children" }
		for _, c in ipairs(Workspace:GetChildren()) do out[#out + 1] = c.Name .. "  [" .. c.ClassName .. "]" end
		out[#out + 1] = "-- keyword matches"
		local KW = { "obito", "obbu", "kamui", "point", "check", "goal", "finish", "raid", "portal", "gate", "reward" }
		local all, n = Workspace:GetDescendants(), 0
		for i = 1, #all do
			local d = all[i]
			local cn = d.ClassName
			if cn ~= "PointLight" and cn ~= "Attachment" and cn ~= "Beam" and cn ~= "ParticleEmitter" and nameHas(d.Name, KW) then
				n = n + 1
				if n <= 400 then
					local p = (d:IsA("BasePart") or d:IsA("Model")) and posOf(d)
					local attrs = {}
					for k, v in pairs(d:GetAttributes()) do attrs[#attrs + 1] = k .. "=" .. tostring(v) end
					out[#out + 1] = string.format("%s [%s]%s %s", d:GetFullName(), cn,
						p and string.format(" (%.0f,%.0f,%.0f)", p.X, p.Y, p.Z) or "", table.concat(attrs, " "))
				end
			end
			if i % 1500 == 0 then task.wait() end
		end
		out[#out + 1] = "-- visible gui text"
		local pg = LP:FindFirstChildOfClass("PlayerGui")
		local g = 0
		if pg then
			for _, d in ipairs(pg:GetDescendants()) do
				if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible and d.Text ~= "" and d.AbsoluteSize.X > 2 then
					g = g + 1
					if g <= 120 then out[#out + 1] = d:GetFullName() .. "  =  " .. string.sub(d.Text, 1, 60) end
				end
			end
		end
		out[#out + 1] = "-- learned remotes"
		for k, v in pairs(L) do
			if type(v) == "table" and v.args then out[#out + 1] = k .. " " .. ser(v.args) end
		end
		local txt = table.concat(out, "\n")
		local saved = false
		if writefile then saved = pcall(writefile, "milk_ahe_modescan.txt", txt) end
		if setclipboard then pcall(setclipboard, txt) end
		status = saved and "saved milk_ahe_modescan.txt" or "scan copied to clipboard"
	end

