		if b and pressButton(b, 1) then
			note("replay button: " .. b:GetFullName())
			hideDialog(b)
			return "button " .. b.Name
		end
		if fireReplayRemote() then return "remote " .. tostring(L.replayCall.name) end
		return nil
	end

	task.spawn(function()
		local seenPopup, rescanAt = -100, os.clock()
		while running do
			local now = os.clock()
			local _, hrp = getChar()
			if hrp then
				local pos = hrp.Position
				if rep.lastPos and (pos - rep.lastPos).Magnitude > 400 and now - D.lastDodge > 1.5 and not D.float then
					if rep.inMode then
						modeEnd("warp out", true)
					elseif rep.endedAt and rep.presses == 0 and not rep.remoteDone and lastUserInput < rep.endedAt then
						rep.strong = true -- sent back to the lobby after the fight: still the same ending
						note("warp after mode end")
					else
						modeStart("warp in")
					end
				end
				rep.lastPos = pos
				local room = myRoom(pos)
				local act = (room and room:GetAttribute("Active") == true) or false
				if room and room == rep.room then
					if act and not rep.roomActive then
						modeStart(room.Name .. " active")
					elseif rep.roomActive and not act then
						modeEnd(room.Name .. " fight finished", true)
					end
				elseif act then
					modeStart(room.Name .. " active")
				end
				rep.room, rep.roomActive = room, act
				if rep.boss then
					if not rep.boss.Parent or (rep.boss:GetAttribute("HP") or 0) <= 0 then modeEnd("boss dead", false) end
				else
					local e, d = nearestEnemy(pos)
					if e and d <= 250 and e:GetAttribute("Mob") ~= true then
						rep.boss = e
						modeStart("boss " .. e.Name)
					end
				end
			else
				rep.lastPos = nil
				if rep.inMode then
					local ch = LP.Character
					local hm = ch and ch:FindFirstChildOfClass("Humanoid")
					if hm and hm.Health <= 0 then modeEnd("you died", false) end
				end
			end
			if OB.n > 0 then modeStart("obito") end
			if rep.inMode and popupAt > seenPopup then modeEnd("reward popup", true) end
			seenPopup = popupAt
			if now - rep.endGuiAt < 1 and (rep.inMode or rep.endedAt) then modeEnd("end screen", true) end

			local rb
			if cfg.AutoReplay then
				if now - rescanAt > 20 then
					rescanAt = now
					task.spawn(rescanReplay)
				end
				-- the taught button showing up is an ending by itself, even if no boss / mode was tracked
				local lb = resolveBtn(L.replayBtn)
				local lbShown = (lb and shown(lb)) or false
				if lbShown and not rep.lbShown and not rep.endedAt and not learn.kind then
					modeEnd("learned replay button appeared", true)
				end
				rep.lbShown = lbShown
				if rep.inMode or rep.endedAt then
					rb = visibleReplayBtn()
					if rb then modeEnd("replay button on screen", true) end
				end
			end

			if rep.endedAt then
				local since = now - rep.endedAt
				local wait_ = cfg.ReplayDelay + (cfg.AutoClaim and (cfg.ClaimDelay + 1) or 0)
				-- pressed, but no new round started: bring the dialog back so it can be pressed again (or by you)
				if rep.hidden and rep.presses >= 1 and now - rep.lastPress > 8 then
					local dlg = rep.hidden
					rep.hidden = nil
					if dlg.Parent then
						dlg.Visible = true
						note("replay did not start a new round -> dialog restored")
					end
				end
				if not cfg.AutoReplay then
					rep.why = "mode ended (auto replay off)"
				elseif userBusy() then
					rep.why = "you are pressing things - replay paused"
				elseif since < wait_ then
					rep.why = string.format("replay in %.1f s", wait_ - since)
				elseif rb and rep.presses < 3 and now - rep.lastPress > 4 then
					rep.presses = rep.presses + 1
					rep.lastPress = now
					if pressButton(rb, rep.presses) then
						if not rep.counted then
							rep.counted = true
							stat.replays = stat.replays + 1
						end
						note("replay button: " .. rb:GetFullName() .. " (press " .. rep.presses .. ")")
						if rep.presses < 3 then hideDialog(rb) end
						rep.why = "replay #" .. stat.replays .. " via button " .. rb.Name .. (rep.presses > 1 and (" (try " .. rep.presses .. ")") or "")
					else
						rep.why = "replay button has no handler - use Learn Replay"
					end
					status = rep.why
				elseif not rb and rep.presses == 0 and not rep.remoteDone and L.replayCall
					and ((rep.strong and since >= wait_ + 1.5) or (since >= wait_ + 6 and not D.combat)) then
					rep.remoteDone = true
					if fireReplayRemote() then
						rep.counted = true
						stat.replays = stat.replays + 1
						rep.why = "replay #" .. stat.replays .. " via remote " .. tostring(L.replayCall.name)
						status = rep.why
					end
				elseif rep.presses == 0 and not rep.remoteDone then
					rep.why = "mode ended - waiting for the replay button"
						.. ((since > wait_ + 10 and not L.replayCall) and " (none seen: use Learn Replay)" or "")
				end
				if since > 90 then rep.endedAt = nil end
			else
				rep.why = rep.inMode and "in mode" or "waiting for a mode"
			end
			task.wait(0.3)
		end
	end)

	-- everything a mode needs you to find: dumps names / paths / attributes / on-screen text to a file + clipboard
	local function modeScan()
		local out = { "-- milk mode scan  " .. os.date("%H:%M:%S"), "-- workspace children" }
		for _, c in ipairs(Workspace:GetChildren()) do out[#out + 1] = c.Name .. "  [" .. c.ClassName .. "]" end
		out[#out + 1] = "-- keyword matches"
		local KW = { "obito", "obbu", "kamui", "point", "check", "goal", "finish", "raid", "portal", "gate", "reward" }
		local all, n = Workspace:GetDescendants(), 0
		for i = 1, #all do
			local d = all[i]
			local cn = d.ClassName
			if cn ~= "PointLight" and cn ~= "Attachment" and cn ~= "Beam" and cn ~= "ParticleEmitter" and nameHas(d.Name, KW) then
				n = n + 1
				if n <= 400 then
					local p = (d:IsA("BasePart") or d:IsA("Model")) and posOf(d)
					local attrs = {}
					for k, v in pairs(d:GetAttributes()) do attrs[#attrs + 1] = k .. "=" .. tostring(v) end
					out[#out + 1] = string.format("%s [%s]%s %s", d:GetFullName(), cn,
						p and string.format(" (%.0f,%.0f,%.0f)", p.X, p.Y, p.Z) or "", table.concat(attrs, " "))
				end
			end
			if i % 1500 == 0 then task.wait() end
		end
		out[#out + 1] = "-- visible gui text"
		local pg = LP:FindFirstChildOfClass("PlayerGui")
		local g = 0
		if pg then
			for _, d in ipairs(pg:GetDescendants()) do
				if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible and d.Text ~= "" and d.AbsoluteSize.X > 2 then
					g = g + 1
					if g <= 120 then out[#out + 1] = d:GetFullName() .. "  =  " .. string.sub(d.Text, 1, 60) end
				end
			end
		end
		out[#out + 1] = "-- learned remotes"
		for k, v in pairs(L) do
			if type(v) == "table" and v.args then out[#out + 1] = k .. " " .. ser(v.args) end
		end
		local txt = table.concat(out, "\n")
		local saved = false
		if writefile then saved = pcall(writefile, "milk_ahe_modescan.txt", txt) end
		if setclipboard then pcall(setclipboard, txt) end
		status = saved and "saved milk_ahe_modescan.txt" or "scan copied to clipboard"
	end

