		local function underEnemy(inst)
			local o = inst.Parent
			while o and o ~= Workspace do
				if o:IsA("Model") and o:GetAttribute("MaxHP") ~= nil and o:GetAttribute("OreType") == nil then return true end
				o = o.Parent
			end
			return false
		end

		local BAD_FLOOR = { "lava", "spike", "moat", "acid", "poison", "kill", "void", "magma" }
		local function ground(x, y, z)
			refreshExclude()
			local hit = Workspace:Raycast(Vector3.new(x, y + 12, z), Vector3.new(0, -60, 0), rp)
			if not hit or underEnemy(hit.Instance) then return nil end
			local hn = string.lower(hit.Instance.Name)
			for _, w in ipairs(BAD_FLOOR) do
				if string.find(hn, w, 1, true) then return nil end -- boss rooms have Arena_FloorLava / Arena_LavaMoat / Arena_Spikes
			end
			return hit.Position
		end

		local arenaFor
		local function standOffset(hrp, hum)
			if hum.RigType == Enum.HumanoidRigType.R15 then return hum.HipHeight + hrp.Size.Y / 2 end
			return 3
		end

		local function floorY(hrp, hum)
			local now = os.clock()
			if now - D.floorAt > 0.25 and hum.FloorMaterial ~= Enum.Material.Air then
				D.floorAt = now
				local g = ground(hrp.Position.X, hrp.Position.Y - standOffset(hrp, hum), hrp.Position.Z)
				if g then D.lastFloor = g.Y end
			end
			if not D.lastFloor then -- never stood on anything yet (spawned in the air): the room's own floor height
				local _, _, fy = arenaFor(hrp.Position)
				if fy then return fy end
			end
			return D.lastFloor
		end

		local function snap(x, z, refY, off)
			if not refY then return nil end
			local g = ground(x, refY, z)
			if not g or g.Y > refY + 10 or g.Y < refY - 25 then return nil end
			return Vector3.new(x, g.Y + off, z)
		end

		------------ who owns a part
