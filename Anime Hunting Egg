	-- dumps what is on screen so the popup can be matched exactly
	local function popupScan()
		local pg = LP:FindFirstChildOfClass("PlayerGui")
		local out = { "-- milk popup scan " .. os.date("%H:%M:%S"), "-- visible buttons" }
		if pg then
			for _, b in ipairs(pg:GetDescendants()) do
				if b:IsA("GuiButton") and shown(b) then
					out[#out + 1] = b:GetFullName() .. "  [" .. b.ClassName .. "]  text=" .. string.sub(btnText(b), 1, 60)
				end
			end
			out[#out + 1] = "-- visible frames with reward/popup/item in the path"
			for _, g in ipairs(pg:GetDescendants()) do
				if g:IsA("GuiObject") and not g:IsA("GuiButton") and shown(g) then
					local path = string.lower(g:GetFullName())
					if hasWord(path, POPUP_PATH) or string.find(path, "item", 1, true) then
						out[#out + 1] = g:GetFullName() .. "  [" .. g.ClassName .. "]" .. ((g:IsA("TextLabel") and g.Text ~= "") and ("  = " .. string.sub(g.Text, 1, 40)) or "")
					end
				end
			end
		end
		out[#out + 1] = "-- notes"
		for i = math.max(1, #notes - 40), #notes do out[#out + 1] = notes[i] end
		local txt = table.concat(out, "\n")
		local saved = false
		if writefile then saved = pcall(writefile, "milk_ahe_popupscan.txt", txt) end
		if setclipboard then pcall(setclipboard, txt) end
		status = saved and "saved milk_ahe_popupscan.txt (also in clipboard)" or "popup scan copied to clipboard"
	end

