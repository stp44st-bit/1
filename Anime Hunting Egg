					"learn claim : " .. (L.claimBtn and ("btn " .. tostring(L.claimBtn.path[#L.claimBtn.path])) or "auto-find") .. (L.claim and ("  remote " .. tostring(L.claim.name)) or ""),
					"popups " .. stat.popups .. "   claims " .. stat.claims,
					"hook        : " .. tostring(stat.hook) .. "   remotes seen " .. tostring(stat.seen),
					"obito       : targets " .. OB.n .. "  grab " .. stat.obGrab .. "  deliver " .. stat.obDeliver,
				}, "\n")
				statusL.Text = "  " .. status
			end
			task.wait(0.5)
		end
	end)

	env.MilkHatch_Unload = function()
		running = false
		env.MilkHatch_Cap2 = nil
		cfg.Hatch, cfg.Sell, cfg.Collect, cfg.Dodge = false, false, false, false
		cfg.AutoReplay, cfg.AutoClaim, cfg.Obito = false, false, false
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
