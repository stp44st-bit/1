								task.wait(0.1)
							else
								status = "obito: no check point found - run Mode Scan"
							end
						end
						OB.skip[best] = os.clock() + 6
					end
				end
				task.wait(0.1)
			else
				OB.n = 0
				task.wait(0.5)
			end
		end
	end)

