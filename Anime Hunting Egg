	section("REPLAY + REWARD")
	toggle("Auto Replay", "AutoReplay")
	cycle("Replay Delay", "ReplayDelay", RDELAYS, " s")
	toggle("Auto Claim Reward Popup", "AutoClaim")
	cycle("Claim Delay", "ClaimDelay", CDELAYS, " s")
	toggle("Virtual Click If Nothing Else Works", "VClick")
	toggle("Hide Popup If It Will Not Close", "HidePopup")
	local bp = btn("Popup Scan (run while the popup is open)")
	track(bp.MouseButton1Click:Connect(function() task.spawn(popupScan) end))
	local br = btn("Replay Now (test)")
	track(br.MouseButton1Click:Connect(function()
		task.delay(0.2, function()
			local how = doReplay()
			status = how and ("replayed via " .. how) or "no replay button on screen"
		end)
	end))
	toggle("Pick Up Dropped Items", "PickDrops")
	local bf = btn("Forget Popup Panels")
	track(bf.MouseButton1Click:Connect(function()
		L.popupPaths, L.btnMethod = {}, {}
		status = "popup panels + press methods forgotten"
	end))

