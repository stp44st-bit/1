	local function popupButtons()
		local out, claimFirst = {}, {}
		for b in pairs(popupCache) do
			if not b.Parent then
				popupCache[b] = nil
			elseif shown(b) then
				local t = btnText(b)
				if not hasWord(t, REPLAY_WORDS) and not hasWord(t, LEAVE_WORDS) and not hasWord(t, POPUP_SKIP) then
					if hasWord(t, CLAIM_WORDS) then claimFirst[#claimFirst + 1] = b else out[#out + 1] = b end
				end
			end
		end
		for _, b in ipairs(out) do claimFirst[#claimFirst + 1] = b end
