	local bs = btn("Mode Scan (run inside the mode)")
	track(bs.MouseButton1Click:Connect(function() task.spawn(modeScan) end))

	section("HATCH")
	toggle("Auto Hatch", "Hatch")
	dyn(function() return "Stand: " .. standLabel(stands()[cfg.Stand]) end, function()
		cfg.Stand = cfg.Stand % math.max(#stands(), 1) + 1
	end)
	toggle("Teleport To Stand", "TpStand")
