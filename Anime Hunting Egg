		local GuiService = S("GuiService")
		local function buttonAt(x, y)
			local pg = LP:FindFirstChildOfClass("PlayerGui")
			if not pg then return nil end
			local ok, list = pcall(pg.GetGuiObjectsAtPosition, pg, x, y)
			if not ok or type(list) ~= "table" then return nil end
			for _, g in ipairs(list) do
				local o = g
				while o and not o:IsA("LayerCollector") do
					if o:IsA("GuiButton") then return o end
					o = o.Parent
				end
			end
			return nil
		end
		track(UIS.InputBegan:Connect(function(i)
			local kind = learn.kind
			if not kind or learn.clickAt then return end
			local t = i.UserInputType
			if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
			if os.clock() > learn.untilT then
				learn.kind = nil
				return
			end
			local x, y = i.Position.X, i.Position.Y
			if win.Visible then -- clicks on this menu do not count
				local ap, sz = win.AbsolutePosition, win.AbsoluteSize
				if x >= ap.X and x <= ap.X + sz.X and y >= ap.Y and y <= ap.Y + sz.Y then return end
			end
			local b = buttonAt(x, y)
			if not b then
				local inset = GuiService:GetGuiInset()
				b = buttonAt(x, y + inset.Y) or buttonAt(x, y - inset.Y)
			end
			learn.clickAt = os.clock()
			learn.gotRemote = false
			if kind == "replay" then
				L.replayCall = nil
				L.replayBtn = b and { inst = b, path = pathOf(b) } or nil
