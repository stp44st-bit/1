	end

	task.spawn(function()
		while running do
			local now = os.clock()
			local _, hrp = getChar()
			if hrp then
				local pos = hrp.Position
				-- big position jump = warped into / out of a mode
				if rep.lastPos and (pos - rep.lastPos).Magnitude > 400 and now - D.lastDodge > 1 then
					if rep.inMode and now - rep.modeAt > 5 then modeEnd("warp out") else modeStart("warp in") end
				end
				rep.lastPos = pos
				-- boss tracking
				if rep.boss then
					if not rep.boss.Parent or (rep.boss:GetAttribute("HP") or 0) <= 0 then
						rep.boss = nil
						modeEnd("boss dead")
					end
				else
					local e, d = nearestEnemy(pos)
					if e and d <= 250 and e:GetAttribute("Mob") ~= true then
						rep.boss = e
						modeStart("boss " .. e.Name)
					end
				end
			else
				rep.lastPos = nil
			end
			if OB.n > 0 then modeStart("obito") end
			if popupAt > rep.popupSeen then
				rep.popupSeen = popupAt
				if rep.inMode then modeEnd("reward popup") end
			end
			if rep.endedAt and rep.burstFor ~= rep.endedAt then
				rep.burstFor = rep.endedAt
				if cfg.AutoClaim then claimBurst() end
			end
			if rep.endedAt then
				local wait_ = cfg.ReplayDelay + (cfg.AutoClaim and cfg.ClaimDelay or 0)
				if not cfg.AutoReplay then
					rep.why = "mode ended (auto replay off)"
					if now - rep.endedAt > 15 then rep.endedAt = nil end
				elseif now - rep.endedAt < wait_ then
					rep.why = string.format("replay in %.1f s", wait_ - (now - rep.endedAt))
				elseif now - rep.last > 4 then
