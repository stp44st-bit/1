	local function autoClaim(src)
		if not cfg.AutoClaim or userBusy() then return false end
		-- 1) learned claim remote (Learn Claim), only right after a popup event
		if src == "event" and L.claim and claimNow() then
			status = "claimed via remote " .. tostring(L.claim.name)
			return true
		end
		-- 2) the button taught with Learn Claim
		local cb = resolveBtn(L.claimBtn)
		if cb and shown(cb) and (not pressedAt[cb] or os.clock() - pressedAt[cb] > 1.5) then
			pressedAt[cb] = os.clock()
			if pressButton(cb, "all") then
				stat.claims = stat.claims + 1
				status = "claimed via learned button " .. cb.Name
				note("claim (learned button): " .. cb:GetFullName() .. " (" .. src .. ")")
				return true
			end
			status = "learned claim button has no click handler"
		end
		-- 3) the popup's own button handler (not a mouse click)
		for _, b in ipairs(popupButtons()) do
			if not pressedAt[b] or os.clock() - pressedAt[b] > 1.5 then
				pressedAt[b] = os.clock()
				if pressButton(b, "all") then
					stat.claims = stat.claims + 1
					status = "claimed via button " .. b.Name
					note("claim button: " .. b:GetFullName() .. " (" .. src .. ")")
					return true
				end
			end
		end
		return false
	end
