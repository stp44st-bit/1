	section("FOREST")
	toggle("Auto Collect Drops", "Collect")
	toggle("Return When Done", "CollectReturn")

	section("MISC")
	local function rebuildEsp()
		for _, o in ipairs(espFolder:GetChildren()) do o:Destroy() end
		if not cfg.ESP then return end
		for _, m in ipairs(stands()) do
			local adornee = m:FindFirstChildWhichIsA("BasePart", true)
			if adornee then
				local bb = mk("BillboardGui", { Adornee = adornee, AlwaysOnTop = true, Size = UDim2.fromOffset(200, 34), StudsOffset = Vector3.new(0, 9, 0), MaxDistance = 100000 }, espFolder)
				mk("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 13,
					TextColor3 = Color3.fromRGB(120, 255, 210), TextStrokeTransparency = 0.3, Text = standLabel(m) }, bb)
			end
		end
	end
	toggle("Egg Stand ESP", "ESP", rebuildEsp)
	toggle("Anti AFK", "AntiAfk")
	toggle("Remote Spy (log)", "Spy")
	local b1 = btn("Save Spy + Notes Log")
	track(b1.MouseButton1Click:Connect(function()
		local txt = "-- notes\n" .. table.concat(notes, "\n") .. "\n-- spy\n" .. table.concat(spyLog, "\n")
		local saved = false
		if writefile then saved = pcall(writefile, "milk_ahe_hatch_log.txt", txt) end
		if setclipboard then pcall(setclipboard, txt) end
		status = saved and "saved milk_ahe_hatch_log.txt" or "log copied to clipboard"
	end))
	local b2 = btn("Forget Learned Remotes")
	track(b2.MouseButton1Click:Connect(function()
		for k in pairs(L) do L[k] = nil end
		status = "cleared - hatch / sell by hand to learn again"
	end))

	section("LIVE")
	local info = mk("TextLabel", { Size = UDim2.new(1, 0, 0, 236), BackgroundColor3 = PANEL, BorderSizePixel = 0, Text = "", TextColor3 = TXT, Font = Enum.Font.Code,
		TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = nextO() }, scroll)
	mk("UICorner", { CornerRadius = UDim.new(0, 5) }, info)
	mk("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingTop = UDim.new(0, 6) }, info)

	track(closeB.MouseButton1Click:Connect(function() if env.MilkHatch_Unload then env.MilkHatch_Unload() end end))
	track(UIS.InputBegan:Connect(function(i, gp)
		if gp then return end
		if i.KeyCode == Enum.KeyCode.Insert then win.Visible = not win.Visible end
		if i.KeyCode == Enum.KeyCode.F6 then cfg.Dodge = not cfg.Dodge end
	end))

	task.spawn(function()
		rebuildEsp()
		while running do
			if win.Visible then
				for _, f in ipairs(repaints) do pcall(f) end
				local n = 0
				for k in pairs(L) do if type(k) == "string" and string.sub(k, 1, 4) == "AHE_" then n = n + 1 end end
				info.Text = table.concat({
					"egg remote : " .. tostring(L.lastEgg or "not learned"),
					"sell remote: " .. (L.AHE_Sell and "learned" or "not learned"),
					"learned     : " .. n .. " remotes",
					"hatched     : " .. stat.hatched,
					"sold        : " .. stat.sold,
					"collected   : " .. stat.collected,
					"combat      : " .. (D.combat and "yes" or "no"),
					"hazards     : " .. D.hazN,
					"dodges      : " .. D.dodges .. "   floats: " .. D.floats .. "   misses: " .. D.misses,
					"wave escape : " .. dodgeSummary(),
					"replay      : " .. rep.why,
					"claim       : " .. rep.claimWhy,
					"replays     : " .. stat.replays,
					"popups " .. stat.popups .. "   claims " .. stat.claims .. "   known panels " .. (function() local n = 0 for _ in pairs(L.popupPaths or {}) do n = n + 1 end return n end)(),
					"hook        : " .. tostring(stat.hook) .. "   remotes seen " .. tostring(stat.seen),
					"obito       : targets " .. OB.n .. "  grab " .. stat.obGrab .. "  deliver " .. stat.obDeliver,
				}, "\n")
				statusL.Text = "  " .. status
			end
			task.wait(0.5)
		end
	end)

	env.MilkHatch_Unload = function()
		running = false
		env.MilkHatch_Cap2 = nil
		cfg.Hatch, cfg.Sell, cfg.Collect, cfg.Dodge = false, false, false, false
		cfg.AutoReplay, cfg.AutoClaim, cfg.Obito = false, false, false
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		conns = {}
		for part in pairs(D.haz) do rmHaz(part) end
		pcall(function() root:Destroy() end)
		env.MilkHatch_Unload = nil
	end

end, milkFail)
if milkOk then
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", { Title = "milk AHE", Text = "loaded. Insert = menu, F6 = dodge", Duration = 5 })
	end)
