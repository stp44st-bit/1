			end
			return false
		end

		local BAD_FLOOR = { "lava", "spike", "moat", "acid", "poison", "kill", "void", "magma" }
		local function ground(x, y, z)
			refreshExclude()
			local hit = Workspace:Raycast(Vector3.new(x, y + 12, z), Vector3.new(0, -60, 0), rp)
			if not hit or underEnemy(hit.Instance) then return nil end
			local hn = string.lower(hit.Instance.Name)
			for _, w in ipairs(BAD_FLOOR) do
				if string.find(hn, w, 1, true) then return nil end -- boss rooms have Arena_FloorLava / Arena_LavaMoat / Arena_Spikes
			end
