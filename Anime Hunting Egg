	------------------------------------------------------------ obito mode (pick up obito / obbu, carry them to the check point)
	local OB = { targets = {}, cps = {}, n = 0, skip = setmetatable({}, { __mode = "k" }) }
	local OB_WORDS = { "obito", "obbu" }
	local CP_WORDS = { "checkpoint", "check_point", "point", "goal", "finish", "deliver", "dropoff", "drop_off", "altar" }
	local CP_BAD = { "light", "spawn", "roam", "path", "wp", "waypoint" }
	local OB_EXCL = { AHE_ObitoFX = true, AHE_Followers = true, AHE_Companions = true, AHE_Stands = true, AHE_PitWalkers = true,
		AHE_HitFX = true, AHE_ForestDrops = true, AHE_DroppedEggs = true, AHE_SkyFX = true, EggStands = true, Hazards = true }
	local OB_CLASS = { Model = true, Part = true, MeshPart = true, UnionOperation = true }

	local function nameHas(nm, words)
		nm = string.lower(nm)
		for _, w in ipairs(words) do
			if string.find(nm, w, 1, true) then return true end
		end
		return false
	end

	local function excluded(inst)
		local o = inst.Parent
		while o and o ~= Workspace do
			if OB_EXCL[o.Name] or (o:IsA("Model") and Players:GetPlayerFromCharacter(o)) then return true end
			o = o.Parent
		end
		return false
	end

	local function considerOb(inst)
		if not OB_CLASS[inst.ClassName] then return end
		local lname = string.lower(inst.Name)
		local isTarget = string.find(lname, "obito", 1, true) or string.find(lname, "obbu", 1, true)
		local isCp = false
		if not isTarget then
			for _, w in ipairs(CP_WORDS) do
				if string.find(lname, w, 1, true) then isCp = true break end
			end
			if isCp then
				for _, w in ipairs(CP_BAD) do
					if string.find(lname, w, 1, true) then isCp = false break end
				end
			end
		end
		if not isTarget and not isCp then return end
		if excluded(inst) then return end
		if isTarget then
			local p = inst.Parent
			if p and p ~= Workspace and nameHas(p.Name, OB_WORDS) then return end   -- parts of an obito model
			if not OB.targets[inst] then
				OB.targets[inst] = true
				note("obito target: " .. inst:GetFullName())
			end
		elseif not OB.cps[inst] then
			OB.cps[inst] = true
			note("check point: " .. inst:GetFullName())
		end
	end

	local function rescanOb()
		local all = Workspace:GetDescendants()
		for i = 1, #all do
			pcall(considerOb, all[i])
			if i % 3000 == 0 then task.wait() end
		end
	end

	-- only watches the workspace while Auto Obito is on (the workspace spawns thousands of fx parts)
	track(Workspace.DescendantAdded:Connect(function(d)
		if cfg.Obito and OB_CLASS[d.ClassName] then pcall(considerOb, d) end
	end))

	local function touchAndPrompt(obj, hrp)
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				d.HoldDuration = 0
				d.RequiresLineOfSight = false
				if fireproximityprompt then pcall(fireproximityprompt, d) end
			elseif d:IsA("TouchTransmitter") and d.Parent and hrp and firetouchinterest then
				pcall(firetouchinterest, hrp, d.Parent, 0)
				pcall(firetouchinterest, hrp, d.Parent, 1)
			end
		end
	end

	local function nearestCp(from)
		local best, bd
		for cp in pairs(OB.cps) do
			if cp.Parent and cp:IsDescendantOf(Workspace) then
				local p = posOf(cp)
				if p then
					local d = (p - from).Magnitude
					if d <= 600 and (not bd or d < bd) then best, bd = cp, d end
				end
			else
				OB.cps[cp] = nil
			end
		end
		return best
	end

	task.spawn(function()
		while running do
			if cfg.Obito then
				local n = 0
				for t in pairs(OB.targets) do
					if t.Parent and t:IsDescendantOf(Workspace) then n = n + 1 else OB.targets[t] = nil end
				end
				OB.n = n
				local _, hrp = getChar()
				if hrp and n > 0 then
					local best, bd
					for t in pairs(OB.targets) do
						if not OB.skip[t] or OB.skip[t] < os.clock() then
							local p = posOf(t)
							if p then
								local d = (p - hrp.Position).Magnitude
								if not bd or d < bd then best, bd = t, d end
							end
						end
					end
					if best then
						local p = posOf(best)
						if p and tp(p + Vector3.new(0, 3, 0)) then
							status = "obito: grabbing " .. best.Name
							touchAndPrompt(best, hrp)
							replaySwap("AHE_Obito", best)
							stat.obGrab = stat.obGrab + 1
							task.wait(0.1)
							local cp = nearestCp(posOf(best) or p)
							local cpp = cp and posOf(cp)
							if cpp then
								status = "obito: to check point " .. cp.Name
								tp(cpp + Vector3.new(0, 3, 0))
								touchAndPrompt(cp, hrp)
								stat.obDeliver = stat.obDeliver + 1
								task.wait(0.1)
							else
								status = "obito: no check point found - run Mode Scan"
							end
						end
						OB.skip[best] = os.clock() + 6
					end
				end
				task.wait(0.1)
			else
				OB.n = 0
				task.wait(0.5)
			end
		end
	end)

