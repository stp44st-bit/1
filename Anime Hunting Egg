			end
			if b then note("learned " .. kind .. " button " .. b:GetFullName()) end
			task.delay(1.6, function() -- the game has had time to fire its remote
				if learn.kind ~= kind then return end
				learn.kind = nil
				local r = (kind == "replay") and L.replayCall or L.claim
				status = "learned " .. kind .. ": " .. (b and ("button " .. b.Name) or "no button under that click")
					.. ((learn.gotRemote and r) and (" + remote " .. tostring(r.name)) or " (no remote fired)")
