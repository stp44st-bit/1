	------------------------------------------------------------ obito mode (pick up obito / obbu, carry them to the check point)
	local OB = { targets = {}, cps = {}, n = 0, skip = setmetatable({}, { __mode = "k" }) }
	local OB_WORDS = { "obito", "obbu" }
	local CP_WORDS = { "checkpoint", "check_point", "point", "goal", "finish", "deliver", "dropoff", "drop_off", "altar" }
	local CP_BAD = { "light", "spawn", "roam", "path", "wp", "waypoint" }
	local OB_EXCL = { AHE_ObitoFX = true, AHE_Followers = true, AHE_Companions = true, AHE_Stands = true, AHE_PitWalkers = true,
		AHE_HitFX = true, AHE_ForestDrops = true, AHE_DroppedEggs = true, AHE_SkyFX = true, EggStands = true, Hazards = true }
	local OB_CLASS = { Model = true, Part = true, MeshPart = true, UnionOperation = true }

	local function nameHas(nm, words)
		nm = string.lower(nm)
		for _, w in ipairs(words) do
			if string.find(nm, w, 1, true) then return true end
		end
		return false
	end

	local function excluded(inst)
		local o = inst.Parent
		while o and o ~= Workspace do
			if OB_EXCL[o.Name] or (o:IsA("Model") and Players:GetPlayerFromCharacter(o)) then return true end
			o = o.Parent
		end
		return false
	end

	local function considerOb(inst)
		if not OB_CLASS[inst.ClassName] then return end
		local lname = string.lower(inst.Name)
		local isTarget = string.find(lname, "obito", 1, true) or string.find(lname, "obbu", 1, true)
		local isCp = false
		if not isTarget then
			for _, w in ipairs(CP_WORDS) do
				if string.find(lname, w, 1, true) then isCp = true break end
			end
			if isCp then
				for _, w in ipairs(CP_BAD) do
					if string.find(lname, w, 1, true) then isCp = false break end
				end
			end
		end
		if not isTarget and not isCp then return end
		if excluded(inst) then return end
		if isTarget then
			local p = inst.Parent
			if p and p ~= Workspace and nameHas(p.Name, OB_WORDS) then return end   -- parts of an obito model
			if not OB.targets[inst] then
				OB.targets[inst] = true
				note("obito target: " .. inst:GetFullName())
			end
		elseif not OB.cps[inst] then
			OB.cps[inst] = true
			note("check point: " .. inst:GetFullName())
		end
	end

	local function rescanOb()
		local all = Workspace:GetDescendants()
		for i = 1, #all do
			pcall(considerOb, all[i])
			if i % 3000 == 0 then task.wait() end
