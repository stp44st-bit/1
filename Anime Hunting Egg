	-- runs the game's own handlers for a button (no mouse click).
	-- mode "all": every click signal (claim buttons). mode n: only the n-th signal that has handlers, so a toggle is never fired twice
	local function pressButton(b, mode)
		local live = {}
		if getconnections then
			for _, sig in ipairs({ b.Activated, b.MouseButton1Click, b.MouseButton1Down, b.MouseButton1Up }) do
				local ok, list = pcall(getconnections, sig)
				if ok and list and #list > 0 then live[#live + 1] = list end
			end
		end
		if #live == 0 then
			if firesignal then
				local ok = pcall(firesignal, b.MouseButton1Click)
				if mode == "all" then pcall(firesignal, b.Activated) end
				return ok
			end
			return false
		end
		local from, to = 1, #live
		if mode ~= "all" then
			from = ((tonumber(mode) or 1) - 1) % #live + 1
			to = from
		end
		local fired = false
		for i = from, to do
			for _, cn in ipairs(live[i]) do
				local ok = pcall(function() cn:Fire() end)
				if not ok then ok = pcall(function() cn.Function() end) end
				if ok then fired = true end
			end
		end
		return fired
	end
	local function findButton(rootGui, want, avoid)
		if not rootGui then return nil end
		for _, b in ipairs(rootGui:GetDescendants()) do
			if b:IsA("GuiButton") and shown(b) and not string.find(b:GetFullName(), "MilkHatch", 1, true) then
				local t = btnText(b)
				if hasWord(t, want) and not hasWord(t, avoid) then return b, t end
			end
		end
	end

	---------------- v8 button engine: finds the end dialog / reward popup on screen every half second and presses it,
	---------------- trying every way to press until the button actually goes away. no mode detection needed.
	local VIM
	pcall(function() VIM = cloneref(game:GetService("VirtualInputManager")) end)
	local GuiServiceB = S("GuiService")
	local POPUP_PATH = { "bosseventui", "reward", "popup", "loot", "itemget", "drop", "claim", "obtain", "unbox" } -- AHE_BossEventUI = the item drop card after a boss
	local POPUP_SKIP = { "login", "shop", "store", "battlepass", "robux", "buy", "purchase", "milk", "quest", "index", "settings", "codes", "egg" }
	local REPLAY_BLOCK = { "egg", "hatch", "buy", "robux", "shop", "store", "milk", "ไข่", "ซื้อ" }
	L.btnMethod = L.btnMethod or {}

	local rep = { why = "idle", lbShown = false, presses = 0, remoteDone = false, last = 0, hidden = nil,
		roomActive = false, room = nil, endedAt = nil, cand = "-", claimWhy = "idle" }

	local function topFrame(b) -- the dialog / popup panel: the child of the ScreenGui that holds the button
		local o = b
		while o.Parent and not o.Parent:IsA("LayerCollector") do o = o.Parent end
		return o
	end

	-- smallest frame that holds this button and a home / leave button = the end dialog
	local function dialogOf(b)
		local o = b.Parent
		local depth = 0
		while o and not o:IsA("LayerCollector") and depth < 6 do
			for _, d in ipairs(o:GetDescendants()) do
				if d ~= b and d:IsA("GuiButton") and shown(d) and hasWord(btnText(d), LEAVE_WORDS) then return o end
			end
			o = o.Parent
			depth = depth + 1
		end
		return nil
	end

	local function guiInsetFor(b)
		local sg = b:FindFirstAncestorWhichIsA("ScreenGui")
		if sg and sg.IgnoreGuiInset then return 0 end
		local ok, inset = pcall(function() return GuiServiceB:GetGuiInset() end)
		return ok and inset.Y or 0
	end

	-- every way this executor has to press a button, in the order tried
	local function pressMethods(b)
		local list = {}
		if getconnections then
			for _, sn in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up" }) do
				local ok, cons = pcall(getconnections, b[sn])
				if ok and type(cons) == "table" and #cons > 0 then
					list[#list + 1] = { name = "conn:" .. sn, fn = function()
						local fired = false
						for _, cn in ipairs(cons) do
							if pcall(function() cn:Fire() end) or pcall(function() cn.Function() end) then fired = true end
						end
						return fired
					end }
				end
			end
		end
		if firesignal then
			list[#list + 1] = { name = "firesignal:Activated", fn = function() return pcall(firesignal, b.Activated) end }
			list[#list + 1] = { name = "firesignal:Click", fn = function() return pcall(firesignal, b.MouseButton1Click) end }
		end
		if cfg.VClick and VIM then
			list[#list + 1] = { name = "virtual click", fn = function()
				local p, s = b.AbsolutePosition, b.AbsoluteSize
				local x, y = p.X + s.X / 2, p.Y + s.Y / 2 + guiInsetFor(b)
				return pcall(function()
					VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
					task.wait(0.05)
					VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
				end)
			end }
		end
		return list
	end

	local function keyOf(b) return table.concat(pathOf(b), "/") end

	-- press, wait, check it worked (button gone or you were moved), else the next method. returns method name or nil
	local function pressUntilGone(b, label, okCheck)
		local key = keyOf(b)
		local list = pressMethods(b)
		if #list == 0 then
			note(label .. ": no way to press on this executor (no getconnections / firesignal / VirtualInputManager)")
			return nil
		end
		-- the method that worked last time goes first
		local remembered = L.btnMethod[key]
		if remembered then
			for i, m in ipairs(list) do
				if m.name == remembered then
					table.remove(list, i)
					table.insert(list, 1, m)
					break
				end
			end
		end
		for _, m in ipairs(list) do
			if not running or not b.Parent or not shown(b) then break end
			local fired = m.fn()
			task.wait(1.8)
			local worked = (not b.Parent) or (not shown(b)) or (okCheck and okCheck())
			note(string.format("%s: %s -> %s%s", label, m.name, fired and "fired" or "failed", worked and " WORKED" or " (still on screen)"))
			if worked then
				L.btnMethod[key] = m.name
				return m.name
			end
		end
		return nil
	end

	---------------- claim (reward popup)
	local busyClaim = false
	local function findPopupButton()
		local cb = resolveBtn(L.claimBtn)
		if cb and shown(cb) then return cb, "learned" end
		local pg = LP:FindFirstChildOfClass("PlayerGui")
		if not pg then return nil end
		local best, bestClaim
		for _, b in ipairs(pg:GetDescendants()) do
			if b:IsA("GuiButton") and shown(b) then
				local path = string.lower(b:GetFullName())
				if hasWord(path, POPUP_PATH) and not hasWord(path, POPUP_SKIP) and not string.find(path, "milkhatch", 1, true) then
					local t = btnText(b)
					if not hasWord(t, REPLAY_WORDS) and not hasWord(t, LEAVE_WORDS) and not hasWord(t, POPUP_SKIP) then
						if hasWord(t, CLAIM_WORDS) then bestClaim = bestClaim or b else best = best or b end
					end
				end
			end
		end
		return bestClaim or best, "found"
	end

	local function autoClaim(src)
		if not cfg.AutoClaim or busyClaim or userBusy() then return false end
		if src == "event" and L.claim and claimNow() then
			rep.claimWhy = "claimed via remote " .. tostring(L.claim.name)
			status = rep.claimWhy
		end
		local b, how = findPopupButton()
		if not b then return false end
		busyClaim = true
		local ok, res = pcall(pressUntilGone, b, "claim " .. b.Name)
		busyClaim = false
		if ok and res then
			stat.claims = stat.claims + 1
			rep.claimWhy = "claimed (" .. how .. " button, " .. res .. ")"
		elseif b.Parent and shown(b) and cfg.HidePopup then
			local panel = topFrame(b)
			if panel:IsA("GuiObject") then
				panel.Visible = false
				stat.claims = stat.claims + 1
				rep.claimWhy = "popup would not close -> hidden on your screen"
				note("hid popup " .. panel:GetFullName())
			end
		else
			rep.claimWhy = "could not press " .. b.Name .. " (see log)"
		end
		status = rep.claimWhy
		return ok and res ~= nil
	end
