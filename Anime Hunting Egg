	local function modeStart(why)
		if rep.inMode then return end
		rep.inMode, rep.endedAt = true, nil
		note("mode start (" .. why .. ")")
		-- buttons that match "replay" but sit on the hud all the time are not the end dialog
		if not rep.lastEndAt or os.clock() - rep.lastEndAt > 20 then
			rep.ignore = setmetatable({}, { __mode = "k" })
			for b in pairs(replayCache) do
				if b.Parent and shown(b) then rep.ignore[b] = true end
			end
		end
		-- a dialog hidden last round: if the game now hides it through a parent, give its own flag back
		local dlg = rep.hidden
		rep.hidden = nil
		if dlg and dlg.Parent and not dlg.Visible then
			local o, parentHidden = dlg.Parent, false
			while o and not o:IsA("LayerCollector") do
				if o:IsA("GuiObject") and not o.Visible then parentHidden = true break end
				o = o.Parent
			end
			if o and o:IsA("ScreenGui") and not o.Enabled then parentHidden = true end
			if parentHidden then dlg.Visible = true end
		end
