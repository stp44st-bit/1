	-- fallback: the game's own replay / retry button, fired through its connections (no mouse click)
	local REPLAY_WORDS = { "replay", "retry", "again", "rematch", "restart", "next", "continue", "เล่นอีก", "ลองใหม่", "เริ่มใหม่", "ต่อไป" }
	local REPLAY_BLOCK = { "egg", "hatch", "buy", "robux", "ไข่", "ซื้อ", "milk" }
	local function shown(g)
		if g.AbsoluteSize.X < 3 then return false end
		local o = g
		while o and not o:IsA("LayerCollector") do
			if o:IsA("GuiObject") and not o.Visible then return false end
			o = o.Parent
		end
		return o ~= nil and not (o:IsA("ScreenGui") and not o.Enabled)
	end
	local function fireReplayButton()
		if not getconnections then return false end
		local pg = LP:FindFirstChildOfClass("PlayerGui")
		if not pg then return false end
		for _, b in ipairs(pg:GetDescendants()) do
			if b:IsA("GuiButton") and shown(b) then
				local t = string.lower(b.Name .. " " .. (b:IsA("TextButton") and b.Text or ""))
				for _, c in ipairs(b:GetChildren()) do if c:IsA("TextLabel") then t = t .. " " .. string.lower(c.Text) end end
				local bad = false
				for _, w in ipairs(REPLAY_BLOCK) do if string.find(t, w, 1, true) then bad = true break end end
				if not bad then
					for _, w in ipairs(REPLAY_WORDS) do
						if string.find(t, w, 1, true) then
							local fired = false
							for _, sig in ipairs({ b.Activated, b.MouseButton1Click, b.MouseButton1Down }) do
								local ok, list = pcall(getconnections, sig)
								if ok and list then
									for _, cn in ipairs(list) do if pcall(function() cn:Fire() end) then fired = true end end
								end
								if fired then break end
							end
							if fired then
								note("replay button: " .. b:GetFullName())
								return true
							end
						end
					end
				end
			end
		end
		return false
	end

