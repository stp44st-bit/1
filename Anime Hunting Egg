	local LEAVE_WORDS = { "leave", "exit", "lobby", "return", "quit", "back", "home", "close", "ออก", "กลับ", "ปิด" }
	local REPLAY_WORDS = { "replay", "retry", "again", "rematch", "restart", "play again", "เล่นอีก", "ลองใหม่", "เริ่มใหม่", "อีกครั้ง" }
