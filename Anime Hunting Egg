		local bodyR = setmetatable({}, { __mode = "k" })
		local function unitR(m)
			local r = m:GetAttribute("UnitRadius")
			if type(r) == "number" then return r end
			r = bodyR[m]
			if not r then
				r = 6
				pcall(function()
					local e = m:GetExtentsSize()
					r = math.clamp(math.max(e.X, e.Z) / 2 * 0.6, 4, 45)
				end)
				bodyR[m] = r
			end
			return r
		end
		local function nearBossFlat(pos, within)
			for _, e in ipairs(D.pts) do
				if flat(e.p, pos) <= within + unitR(e.m) then return true end
			end
			return false
		end

		-- arena bounds so a ground dodge stays inside the fight room when it can
		arenaFor = function(pos)
			if os.clock() - D.arenaAt > 10 then
				D.arenaAt = os.clock()
				D.arenas = {}
				for _, r in ipairs(Workspace:GetChildren()) do
					local c, rad = r:GetAttribute("Center"), r:GetAttribute("Radius")
					if typeof(c) == "Vector3" and type(rad) == "number" and rad >= 60 then -- lobby zones (sell / shop ...) are 9-30 wide
						local fy = r:GetAttribute("FloorY")
						D.arenas[#D.arenas + 1] = { c = c, r = rad, floor = type(fy) == "number" and fy or c.Y }
					end
				end
			end
			for _, a in ipairs(D.arenas) do
				if flat(a.c, pos) <= a.r * 1.25 and math.abs(pos.Y - a.c.Y) < 700 then return a.c, a.r, a.floor end
			end
		end

		------------ hazards
		rmHaz = function(part)
			local h = D.haz[part]
			if not h then return end
			D.haz[part] = nil
			D.hazN = D.hazN - 1
			if h.box then pcall(function() h.box:Destroy() end) end
			if h.conn then h.conn:Disconnect() end
		end

		makeBox = function(h)
			if h.box or not adorn then return end
			h.box = mk("BoxHandleAdornment", { Adornee = h.part, Size = h.size, AlwaysOnTop = true, ZIndex = 5, Transparency = 0.65,
				Color3 = h.wave and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(255, 60, 60) }, adorn)
		end

		local function readAttrR(inst)
			for _, k in ipairs(R_KEYS) do
				local v = inst:GetAttribute(k)
				if type(v) == "number" and v >= 2 and v <= 500 then return v end
			end
			return nil
		end

		-- real size: a tiny part with a scaled SpecialMesh is as big as the mesh
		local function measure(h)
			local part = h.part
			local s = part.Size
			local m = h.mesh
			if m and m.Parent == part then
				local sc = m.Scale
				if m.MeshType == Enum.MeshType.FileMesh then
					s = Vector3.new(math.min(math.max(s.X, sc.X * 2), 400), math.min(math.max(s.Y, sc.Y * 2), 400), math.min(math.max(s.Z, sc.Z * 2), 400))
				else
					s = Vector3.new(s.X * sc.X, s.Y * sc.Y, s.Z * sc.Z)
				end
			end
			h.size = s
			return math.max(s.X, s.Y, s.Z)
		end

		-- horizontal radius + "is it a flat disc / plate"
		local function footprint(h)
			local s = h.size
			local r, isFlat
			if h.shape == CYL then
				r = math.max(s.Y, s.Z) / 2
				isFlat = s.X < r * 0.5
			elseif h.shape == BALL then
				r = math.max(s.X, s.Y, s.Z) / 2
				isFlat = false
			else
				local mn = math.min(s.X, s.Y, s.Z)
				local mx = math.max(s.X, s.Y, s.Z)
				local mid = s.X + s.Y + s.Z - mn - mx
				r = mx / 2
				isFlat = (mn < 4 or mn < mx * 0.2) and mid >= mx * 0.5
			end
			if h.attrR and h.attrR > r then
				r = h.attrR
				isFlat = true
			end
			return r, isFlat
		end

		local function inside(h, pos, margin)
			local part = h.part
			local s = h.size
			local big = h.big
			local sr = h.attrR or (big < 1.5 and h.minR or nil)
			if sr then
				local c = part.Position
				if flat(pos, c) <= sr + margin and math.abs(pos.Y - c.Y) <= math.max(VR, sr) then return true end
			end
			if big < 1.5 then return false end
			local rel = part.CFrame:PointToObjectSpace(pos)
			if h.shape == BALL then
				return rel.Magnitude <= big / 2 + margin
			end
			if h.shape == CYL then
				local r = math.max(s.Y, s.Z) / 2
				local radial = math.sqrt(rel.Y * rel.Y + rel.Z * rel.Z)
				local halfH = (s.X < r) and (s.X / 2 + VR) or (s.X / 2 + margin)
				return radial <= r + margin and math.abs(rel.X) <= halfH
			end
			local ax = { s.X, s.Y, s.Z }
			local rl = { rel.X, rel.Y, rel.Z }
			local mn = 1
			if ax[2] < ax[mn] then mn = 2 end
			if ax[3] < ax[mn] then mn = 3 end
			if ax[mn] < 3 then -- flat telegraph: generous reach through its thin axis
				if math.abs(rl[mn]) > ax[mn] / 2 + VR then return false end
				local i, j = 2, 3
				if mn == 2 then i, j = 1, 3 elseif mn == 3 then i, j = 1, 2 end
				return math.abs(rl[i]) <= ax[i] / 2 + margin and math.abs(rl[j]) <= ax[j] / 2 + margin
			end
			return math.abs(rl[1]) <= ax[1] / 2 + margin and math.abs(rl[2]) <= ax[2] / 2 + margin and math.abs(rl[3]) <= ax[3] / 2 + margin
		end

		local function addZone(c, r, life)
			D.zones[#D.zones + 1] = { center = c, r = r, untilT = os.clock() + life }
			D.lastHazAt = os.clock()
		end

		local stepRef
		local lastImmediate, inStep = 0, false
		local function addHaz(part, src, life)
			if D.haz[part] or expired[part] or not part.Parent then return end
			if D.hazN >= MAX_HAZ then -- full: drop the oldest instead of ignoring the new one
				local oldest, ot
				for p, h in pairs(D.haz) do
					if not ot or h.born < ot then oldest, ot = p, h.born end
				end
				if oldest then
					expired[oldest] = true
					rmHaz(oldest)
				end
			end
			local now = os.clock()
			local parent = part.Parent
			local nm = string.lower(part.Name .. " " .. (parent and parent.Name or ""))
			local shape = part:IsA("Part") and part.Shape or nil
			local mesh = part:FindFirstChildOfClass("SpecialMesh")
			if mesh and mesh.MeshType == Enum.MeshType.Sphere then shape = BALL end
			local attrR = readAttrR(part)
			if not attrR and src == "folder" and parent and parent.Name ~= "AHE_BossAttacks" then attrR = readAttrR(parent) end
			local h = { part = part, src = src, born = now, expire = life and (now + life) or nil, last = part.Position, vel = Vector3.zero, speed = 0,
				size = part.Size, big = 0, rate = 0, grow = 0, waveNamed = hasAny(nm, WAVE_WORDS), wave = false, radius = 0, flat = false,
				shape = shape, mesh = mesh, attrR = attrR, minR = nil }
			h.big = measure(h)
			h.radius, h.flat = footprint(h)
			D.haz[part] = h
			D.hazN = D.hazN + 1
			D.lastHazAt = now
			h.conn = part.AncestryChanged:Connect(function()
				if not part:IsDescendantOf(Workspace) then rmHaz(part) end
			end)
			if cfg.ShowHazards then makeBox(h) end
			local key = src .. ":" .. part.Name
			hazLogged[key] = (hazLogged[key] or 0) + 1
			if hazLogged[key] <= 3 then
				note(string.format("HAZ[%s] %s size=(%.0f,%.0f,%.0f)%s", src, part:GetFullName(), h.size.X, h.size.Y, h.size.Z, attrR and (" attrR=" .. attrR) or ""))
			end
			if stepRef and not inStep and now - lastImmediate > 0.03 then
				lastImmediate = now
				pcall(stepRef, 0)
			end
		end

		-- every known hazard / zone. withWaves = also count 360 waves; k scales how far ahead growth is predicted
		local function danger(pos, margin, withWaves, k)
			k = k or 1
			if #D.zones > 0 then
				local now = os.clock()
				for i = #D.zones, 1, -1 do
					local z = D.zones[i]
					if now > z.untilT then
						table.remove(D.zones, i)
					elseif flat(pos, z.center) <= z.r + margin and math.abs(pos.Y - z.center.Y) < math.max(30, z.r) then
						return true, z.center
					end
				end
			end
			for part, h in pairs(D.haz) do
				if part.Parent and (withWaves or not h.wave) then
					local m = margin + h.grow * k
					if inside(h, pos, m) then return true, part.Position, h end
					if h.speed > 8 then -- moving hazard / projectile: where it will be over the next 0.6 s
						local v = h.vel
						for i = 1, 4 do
							if inside(h, pos - v * (0.15 * i), m) then return true, part.Position, h end
						end
					end
				end
			end
			return false
		end

		local tickAt = 0
		local function updateHazards(dt)
			if D.hazN == 0 then return end
			local now = os.clock()
			local slow = now - tickAt > 0.1
			if slow then tickAt = now end
			for part, h in pairs(D.haz) do
				if not part.Parent then
					rmHaz(part)
				elseif h.expire and now > h.expire then
					expired[part] = true
					rmHaz(part)
				else
					local p = part.Position
					if dt > 0 then
						local v = (p - h.last) / dt
						if not part.Anchored then
							local av = part.AssemblyLinearVelocity
							if av.Magnitude > v.Magnitude then v = av end
						end
						if v.Magnitude > 400 then v = v.Unit * 400 end
						h.vel = h.vel:Lerp(v, 0.5)
						h.speed = h.vel.Magnitude
						h.last = p
						local big = measure(h)
						local r = (big - h.big) / dt
						h.big = big
						if r < 0 then r = 0 end
						h.rate = h.rate + (r - h.rate) * 0.35
					end
					h.grow = math.clamp(h.rate * 0.3, 0, 40)
					if slow then
						local age = now - h.born
						if age < 1.5 then
							if not h.mesh then
								h.mesh = part:FindFirstChildOfClass("SpecialMesh")
								if h.mesh and h.mesh.MeshType == Enum.MeshType.Sphere then h.shape = BALL end
							end
							if not h.attrR then h.attrR = readAttrR(part) end
						if not h.tele and part:FindFirstChildOfClass("SurfaceGui") then
							h.tele = true
							h.minR = h.minR or math.max(h.size.X, h.size.Z) / 2
						end
							if h.big < 1.5 and not h.minR and age > 0.3 and h.src == "folder"
								and (part:FindFirstChildWhichIsA("ParticleEmitter", true) or part:FindFirstChildWhichIsA("Beam", true)) then
								h.minR = 8 -- invisible emitter part: treat it as a small circle
							end
						end
						local r, isFlat = footprint(h)
						h.radius, h.flat = r, isFlat
						local was = h.wave
						h.wave = (nearBossFlat(p, 22)
							and (h.waveNamed or (isFlat and (r >= 25 or h.rate > 15)) or (h.shape == BALL and h.rate > 10)))
							or (h.rate > 25 and r >= 12 and (isFlat or h.shape == BALL or h.shape == CYL)) -- shockwave racing outwards
							or (h.waveNamed and h.rate > 5) or false
						if h.wave and not was then
							note(string.format("WAVE %s r=%.0f rate=%.0f", part.Name, r, h.rate))
							if h.box then h.box.Color3 = Color3.fromRGB(255, 200, 40) end
						end
						if h.box then h.box.Size = h.size end
					end
				end
			end
		end

		local function waveThreat(pos)
			for part, h in pairs(D.haz) do
				if h.wave and part.Parent then
					local c = part.Position
					if flat(pos, c) <= h.radius + cfg.Margin + math.min(h.rate * 0.5, 150) and math.abs(pos.Y - c.Y) < math.max(30, h.radius) then
						return true
					end
				end
			end
			return false
		end

		-- how high above the floor you must be to be out of this hazard
		local function clearHeight(h, baseY, gpos)
			local part = h.part
			local cf, s = part.CFrame, h.size
			local ext = (math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.LookVector.Y) * s.Z) / 2
			local top = part.Position.Y + ext - baseY
			if h.flat then
				-- servers often test plain 3d distance to the centre, so the height has to beat the radius
				local R = h.radius + math.min(h.rate * 0.5, 150) + 8
				local d = flat(gpos, part.Position)
				return math.max(math.sqrt(math.max(R * R - d * d, 0)), top + VR + 6)
			end
			return math.max(top + 10, 0)
		end

		local function needHeight(gpos, baseY)
			local H = cfg.FloatMin
			local m = cfg.Margin + 4
			for part, h in pairs(D.haz) do
				if part.Parent and (h.big >= 1.5 or h.attrR or h.minR) then
					if flat(gpos, part.Position) <= h.radius + m + math.min(h.rate * 0.5, 150) then
						local ch = clearHeight(h, baseY, gpos)
						if ch > H then H = ch end
					end
				end
			end
			for _, z in ipairs(D.zones) do
				if flat(gpos, z.center) <= z.r + m and z.r + 8 > H then H = z.r + 8 end
			end
			return math.min(H * D.boost, cfg.FloatMax) -- capped: your units follow you and cannot reach the boss from high up
		end

		local function findSafe(pos, threat, refY, off, ignoreArena, hz)
			if not refY then return nil end
			local side -- a moving hazard is dodged sideways, not along its path
			if hz and hz.speed > 8 then
				local v = Vector3.new(hz.vel.X, 0, hz.vel.Z)
				if v.Magnitude > 1 then side = v.Unit end
			end
			local ac, ar
			if not ignoreArena then ac, ar = arenaFor(pos) end
			local away
			if threat then
				local d = Vector3.new(pos.X - threat.X, 0, pos.Z - threat.Z)
				if d.Magnitude > 0.5 then away = d.Unit end
			end
			local need = cfg.Margin + 6
			local y = refY + off
			local dist = cfg.MinDodge
			while dist <= MAX_SEARCH do
				local cands = {}
				for _, dir in ipairs(DIRS) do
					local x, z = pos.X + dir.X * dist, pos.Z + dir.Z * dist
					if (not ac or flat(ac, Vector3.new(x, 0, z)) <= ar - 4) and not danger(Vector3.new(x, y, z), need, true, 2) then
						cands[#cands + 1] = { x = x, z = z, s = side and math.abs(dir:Dot(side)) or (away and (1 - dir:Dot(away)) or 0) }
					end
				end
				if #cands > 0 then
					table.sort(cands, function(a, b) return a.s < b.s end)
					for i = 1, math.min(#cands, 5) do
						local p = snap(cands[i].x, cands[i].z, refY, off)
						if p then return p end
					end
				end
				dist = dist + 10
			end
			return nil
		end

		-- wave escape, learned per boss:  1 = go straight up   2 = hover outside the wave's reach   3 = outside and high
		local MODE_NAME = { [0] = "ground", "up", "out", "out+up" }
		local function bossKey()
			local _, hrp = getChar()
			local m = hrp and nearestEnemy(hrp.Position)
			if not m then return "?" end
			return tostring(m:GetAttribute("BossId") or m:GetAttribute("BossName") or m.Name)
		end
		local function waveMode() return D.wmode[bossKey()] or 0 end

		dodgeSummary = function()
			local sig = 0
			for _, l in pairs(D.sigLearn) do if l.c >= 2 then sig = sig + 1 end end
			return string.format("%s  signals %d  parts %d  x%.1f", MODE_NAME[waveMode()], sig, D.learnedN, D.boost)
		end

		local function escapePos(f)
			local mode = f.mode
			local H = needHeight(f.ground, f.baseY)
			if mode == 1 then return Vector3.new(f.ground.X, f.baseY + H, f.ground.Z) end
			-- centre of the trouble: the fight room, else the boss, else the biggest wave
			local c, ar = arenaFor(f.ground)
			local reach, wc = 0, nil
			for part, h in pairs(D.haz) do
				if part.Parent and (h.wave or h.big >= 20) then
					local r = h.radius + math.min(h.rate * 0.6, 200)
					if r > reach then reach, wc = r, part.Position end
				end
			end
			if not c then
				local _, _, bp = nearestEnemy(f.ground)
				c = bp or wc or f.ground
			end
			local dir = Vector3.new(f.ground.X - c.X, 0, f.ground.Z - c.Z)
			dir = dir.Magnitude > 1 and dir.Unit or Vector3.new(1, 0, 0)
			local dist = math.min(math.max(ar or 0, reach, flat(f.ground, c)) + 70 * D.boost, 900)
			local y = (mode == 3) and (f.baseY + H) or (f.baseY + 4)
			return Vector3.new(c.X + dir.X * dist, y, c.Z + dir.Z * dist)
		end

		-- a floor spot outside every wave's 1.5 s reach, inside the room, not in another hazard
		waveGroundEscape = function(pos, refY, off)
			if not refY then return nil end
			local ac, ar = arenaFor(pos)
			local best, bestD
			for _, dir in ipairs(DIRS) do
				-- distance along this direction that clears every wave's reach 1.5 s from now
				local d = cfg.MinDodge
				for part, h in pairs(D.haz) do
					if h.wave and part.Parent then
						local c = part.Position
						local reach = h.radius + h.rate * 1.5 + cfg.Margin + 6
						local rx, rz = pos.X - c.X, pos.Z - c.Z
						local b = rx * dir.X + rz * dir.Z
						local disc = b * b - (rx * rx + rz * rz - reach * reach)
						if disc > 0 then
							local dd = -b + math.sqrt(disc)
							if dd > d then d = dd end
						end
					end
				end
				if d <= 140 and (not bestD or d < bestD) then
					local p3 = Vector3.new(pos.X + dir.X * d, refY + off, pos.Z + dir.Z * d)
					if (not ac or flat(ac, p3) <= ar - 4) and not danger(p3, cfg.Margin + 4, false, 2) then
						local g = snap(p3.X, p3.Z, refY, off)
						if g then best, bestD = g, d end
					end
				end
			end
			return best
		end

		local function startFloat(hrp, pos, refY, off, why, hold)
			local now = os.clock()
			local baseY = refY and (refY + off) or pos.Y
			local g = Vector3.new(pos.X, baseY, pos.Z)
			local f = { ground = g, baseY = baseY, off = off, t0 = now, hits = 0, lastBoost = 0, clearAt = nil,
				mode = math.max(waveMode(), 1), boss = bossKey(), holdUntil = now + (hold or 0) }
			f.pos = escapePos(f)
			D.float = f
			D.floats = D.floats + 1
			D.lastDodge = now
			hrp.CFrame = CFrame.new(f.pos) * hrp.CFrame.Rotation
			hrp.AssemblyLinearVelocity = Vector3.zero
			status = string.format("%s -> escape %s (#%d)", why, MODE_NAME[f.mode], D.floats)
		end

		------------ boss signals (roar / ult / attack anims / cast events), learned from hits
		local function pushSignal(key)
			local now = os.clock()
			local sg = D.sigs
			sg[#sg + 1] = { k = key, t = now }
			while sg[1] and now - sg[1].t > 6 do table.remove(sg, 1) end
			if not cfg.Dodge then return end
			local l = D.sigLearn[key]
			local always = cfg.EscapeOnUlt and (string.sub(key, 1, 3) == "ULT" or string.sub(key, 1, 5) == "ROAR:")
			if not ((l and l.c >= 2) or always) then return end
			local hold = (l and l.hold) or 2.5
			local f = D.float
			if f then
				f.holdUntil = math.max(f.holdUntil, now + hold)
				return
			end
			local _, hrp, hum = getChar()
			if not hrp then return end
			startFloat(hrp, hrp.Position, D.lastFloor, standOffset(hrp, hum), "signal " .. key, hold)
			note(string.format("SIGNAL %s -> escape %s for %.1f s", key, MODE_NAME[D.float.mode], hold))
		end

		-- a hit: every signal seen in the last 4 s gets the blame; two hits after the same signal = it is dodged from then on
		local function blameSignals(now)
			for _, sgl in ipairs(D.sigs) do
				local dt = now - sgl.t
				if dt <= 4 and not sgl.blamed then
					sgl.blamed = true
					local l = D.sigLearn[sgl.k] or { c = 0, hold = 2.5 }
					l.c = l.c + 1
					l.hold = math.min(math.max(l.hold, dt + 1), 6)
					D.sigLearn[sgl.k] = l
					if l.c == 2 then note(string.format("LEARNED signal %s (hold %.1f s)", sgl.k, l.hold)) end
				end
			end
		end

		------------ wide detection: attack parts that are not inside AHE_BossAttacks
		local function classifyWide(part, now, hrpPos)
			if D.haz[part] or expired[part] or not part.Parent then return true end
			if part.CanCollide then return true end
			if (part.Position - hrpPos).Magnitude > 300 then return true end
			local s = part.Size
			local big = math.max(s.X, s.Y, s.Z)
			local mesh = part:FindFirstChildOfClass("SpecialMesh")
			if mesh then big = math.max(big, mesh.Scale.Magnitude) end
			if big < 3 then return false end -- may still be growing, look again
			local top = topName(part)
			local src
			if FX_FOLDERS[top] then
				if big >= 6 then src = "fx" end
			elseif (D.learned[top .. "/" .. part.Name] or 0) >= 2 then
				src = "learned"
			else
				local parent = part.Parent
				if hasAny(string.lower(part.Name .. " " .. (parent and parent.Name or "")), HAZ_WORDS) then
					src = "name"
				elseif big >= 8 and now - D.lastCast <= 1.2 and now - (stat.ownSkillAt or -100) > 1 then
					src = "cast"
				end
			end
			if not src then return big >= 8 end
			local kind = ownerKind(part)
			if kind == "player" or kind == "excl" then return true end
			addHaz(part, src, 6)
			return true
		end

		local function processRecent(now, hrpPos)
			if not cfg.WideDetect then return end
			for i = 1, #recent do
				local r = recent[i]
				if r.n < 3 then
					local age = now - r.t
					if age > 1 then
						r.n = 3
					elseif r.n == 0 or (r.n == 1 and age >= 0.12) or (r.n == 2 and age >= 0.4) then
						r.n = r.n + 1
						local ok, done = pcall(classifyWide, r.p, now, hrpPos)
						if not ok or done then r.n = 3 end
					end
				end
			end
		end

		-- a hit nothing predicted: write down what appeared around you so the detector can be fixed / can learn
		local saveAt = -100
		local function autoSaveLog()
			if not writefile or os.clock() - saveAt < 4 then return end
			saveAt = os.clock()
			pcall(writefile, "milk_ahe_dodgelog.txt", "-- milk dodge log (auto-saved on every missed dodge) " .. os.date("%H:%M:%S") .. "\n" .. table.concat(notes, "\n"))
		end
		local function logHazards(pos)
			local n = 0
			for part, h in pairs(D.haz) do
				if part.Parent and n < 12 then
					local c = part.Position
					local d = flat(pos, c)
					if d <= 160 then
						n = n + 1
						note(string.format("   hazard %s size=(%.0f,%.0f,%.0f) r=%.0f rate=%.0f dist=%.0f dy=%.0f%s%s%s age=%.1f", part.Name,
							h.size.X, h.size.Y, h.size.Z, h.radius, h.rate, d, pos.Y - c.Y, h.wave and " WAVE" or "", h.tele and " TELE" or "",
							inside(h, pos, cfg.Margin) and " (you were inside)" or "", os.clock() - h.born))
					end
				end
			end
			if n == 0 then note("   no tracked hazard within 160 studs") end
		end
		local function logMiss(pos, lost)
			local now = os.clock()
			logHazards(pos)
			if cfg.LearnHits then blameSignals(now) end
			do
				local list = {}
				for _, sgl in ipairs(D.sigs) do
					if now - sgl.t <= 4 then list[#list + 1] = string.format("%s(-%.1fs)", sgl.k, now - sgl.t) end
				end
				if #list > 0 then note("   signals before it: " .. table.concat(list, " ")) end
			end
			local bm = nearestEnemy(pos)
			note(string.format("MISS #%d  hp -%.0f%%  hazards=%d zones=%d  boss=%s", D.misses, lost * 100, D.hazN, #D.zones, bm and bm.Name or "?"))
			local n, seen = 0, {}
			for i = 1, #recent do
				local r = recent[i]
				local p = r.p
				if p.Parent and now - r.t <= 2.5 and (p.Position - pos).Magnitude <= 90 then
					local kind = ownerKind(p)
					if kind ~= "player" then
						n = n + 1
						local s = p.Size
						if n <= 12 then
							note(string.format("   suspect %s [%s] size=(%.0f,%.0f,%.0f) age=%.1f %s%s", p:GetFullName(), p.ClassName, s.X, s.Y, s.Z,
								now - r.t, kind or "", D.haz[p] and " (was tracked)" or ""))
						end
						if cfg.LearnHits and kind ~= "excl" and not D.haz[p] and not GENERIC[p.Name] and not p.CanCollide
							and now - r.t <= 1.5 and math.max(s.X, s.Y, s.Z) >= 4 then
							local key = topName(p) .. "/" .. p.Name
							if not seen[key] then
								seen[key] = true
								local c = (D.learned[key] or 0) + 1
								D.learned[key] = c
								if c == 2 then
									D.learnedN = D.learnedN + 1
									note("LEARNED hazard source: " .. key)
								end
							end
						end
					end
				end
			end
			if n == 0 then note("   nothing new appeared near you (melee / server-only hitbox)") end
			autoSaveLog()
		end

		resetDodgeLearning = function()
			D.boost, D.far, D.learnedN = 1, false, 0
			for k in pairs(D.learned) do D.learned[k] = nil end
			for k in pairs(D.wmode) do D.wmode[k] = nil end
			for k in pairs(D.sigLearn) do D.sigLearn[k] = nil end
		end

		------------ per frame
		local function step(dt)
			updateHazards(dt)
			local _, hrp, hum = getChar()
			if not hrp then
				D.lastHp, D.origin, D.float, D.lastFloor = nil, nil, nil, nil
				return
			end
			if not cfg.Dodge then
				D.float = nil
				D.lastHp = hum.Health
				return
			end
			local now = os.clock()
			-- nothing to react to: skip raycasts / scans this frame
			if not D.float and not D.origin and D.hazN == 0 and #D.zones == 0 and not D.combat and now - D.lastHazAt > 15 then
				D.lastHp = hum.Health
				return
			end
			if dt > 0 then
				inStep = true
				pcall(processRecent, now, hrp.Position)
				inStep = false
			end
			local refY = floorY(hrp, hum)
			local off = standOffset(hrp, hum)
			local hp, maxHp = hum.Health, hum.MaxHealth
			local lost = (D.lastHp and maxHp > 0) and (D.lastHp - hp) / maxHp or 0
			D.lastHp = hp

			-- out of a skill's reach (up / out / out+up)
			local f = D.float
			if f then
				D.lastDodge = now
				local want = escapePos(f)
				if f.mode == 1 then
					if want.Y > f.pos.Y then f.pos = want end
				elseif flat(want, f.ground) > flat(f.pos, f.ground) + 5 or want.Y > f.pos.Y + 5 then
					f.pos = want
				end
				local threatened, threat = danger(f.ground, cfg.Margin + 4, true, 1.5)
				if now < f.holdUntil then threatened = true end
				if lost > 0.02 and now - f.t0 > 0.15 and now - f.lastBoost > 0.4 then
					f.lastBoost = now
					f.hits = f.hits + 1
					D.misses = D.misses + 1
					D.lastMiss = now
					if cfg.LearnHits then blameSignals(now) end
					if f.mode < 3 then
						f.mode = f.mode + 1
						D.wmode[f.boss] = f.mode
						note(string.format("HIT while escaping -> %s now uses '%s'", f.boss, MODE_NAME[f.mode]))
						logHazards(f.ground)
						autoSaveLog()
					else
						D.boost = math.min(D.boost * 1.5, 5)
						note(string.format("HIT even out+up -> range x%.1f (if this keeps happening the hit is not position based)", D.boost))
					end
					f.pos = escapePos(f)
					f.holdUntil = math.max(f.holdUntil, now + 1)
				end
				if threatened then f.clearAt = nil elseif not f.clearAt then f.clearAt = now end
				local age = now - f.t0
				local land
				if f.clearAt and now - f.clearAt >= 0.15 and age >= 0.35 then
					land = f.ground
				elseif age > 10 then
					land = findSafe(f.ground, threat, f.baseY - f.off, f.off, false) or findSafe(f.ground, threat, f.baseY - f.off, f.off, true)
					if not land and age > 20 then land = f.ground end
				end
				if land then
					D.float = nil
					if land ~= f.ground and not D.origin then D.origin = f.ground end
					hrp.CFrame = CFrame.new(land) * hrp.CFrame.Rotation
					hrp.AssemblyLinearVelocity = Vector3.zero
					status = "skill passed, back on the ground"
				else
					hrp.CFrame = CFrame.new(f.pos) * hrp.CFrame.Rotation
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
				return
			end

			local pos = hrp.Position

			-- hit bookkeeping
			local unpredicted = false
			if lost > 0.03 and now - D.lastMiss > 0.7 and (D.combat or now - D.lastHazAt < 15) then
				D.lastMiss = now
				D.misses = D.misses + 1
				if D.lastWaveGround and now - D.lastWaveGround < 2.5 then
					local bk = bossKey()
					if (D.wmode[bk] or 0) == 0 then
						D.wmode[bk] = 1
						note("HIT after a ground wave escape -> " .. bk .. " now uses 'up'")
					end
					D.lastWaveGround = nil
				end
				if now - D.lastDodge <= 0.5 then
					note(string.format("LATE hit %.2f s after a dodge  hp -%.0f%%", now - D.lastDodge, lost * 100))
					if cfg.LearnHits then blameSignals(now) end
				else
					unpredicted = true
				end
			end

			-- 360 wave: step outside where it will be in 1.5 s on the ground (units keep hitting); in the air only if that fails
			if D.hazN > 0 and cfg.WaveFloat and waveThreat(pos) then
				local tgt = (waveMode() == 0) and waveGroundEscape(pos, refY, off) or nil
				if tgt then
					if not D.origin and refY then D.origin = Vector3.new(pos.X, refY + off, pos.Z) end
					D.dodges = D.dodges + 1
					D.lastDodge, D.lastWaveGround, D.safeSince = now, now, 0
					tp(tgt)
					status = string.format("wave -> ground escape %.0f studs", flat(pos, tgt))
				else
					startFloat(hrp, pos, refY, off, "360 wave")
				end
				return
			end

			local inDanger, threat, hz = false, nil, nil
			if D.hazN > 0 or #D.zones > 0 then
				inDanger, threat, hz = danger(pos, cfg.Margin, D.far or not cfg.WaveFloat, 1)
			end

			if inDanger then
				D.safeSince = 0
				if unpredicted then note("   (hit while standing in a known hazard: it was detected too late)") end
				if now - D.lastDodge > 0.08 then
					D.lastDodge = now
					local tgt = findSafe(pos, threat, refY, off, false, hz)
					if not tgt and D.far then tgt = findSafe(pos, threat, refY, off, true, hz) end
					if not tgt and cfg.WaveFloat then
						startFloat(hrp, pos, refY, off, "no safe floor")
						return
					end
					tgt = tgt or findSafe(pos, threat, refY, off, true, hz)
					if tgt then
						if not D.origin and refY then D.origin = Vector3.new(pos.X, refY + off, pos.Z) end
						D.dodges = D.dodges + 1
						tp(tgt)
						status = string.format("dodge #%d  %.0f studs", D.dodges, flat(pos, tgt))
					else
						status = "no safe floor found"
					end
				end
				return
			end

			if unpredicted then
				logMiss(pos, lost)
				if cfg.HitDodge then
					local _, _, bp = nearestEnemy(pos)
					addZone(pos, math.max(cfg.MinDodge * 0.5, 10), 1.2)
					local tgt = findSafe(pos, bp or pos, refY, off, false) or findSafe(pos, bp or pos, refY, off, true)
					if tgt then
						if not D.origin and refY then D.origin = Vector3.new(pos.X, refY + off, pos.Z) end
						D.lastDodge = now
						D.safeSince = 0
						tp(tgt)
						status = "unpredicted hit -> moved away (see log)"
					end
				end
				return
			end

			if D.origin then
				if flat(pos, D.origin) > 400 then
					D.origin = nil
				elseif cfg.ReturnBack then
					if D.safeSince == 0 then D.safeSince = now end
					if now - D.safeSince >= 0.5 then
						local back = snap(D.origin.X, D.origin.Z, refY or (D.origin.Y - off), off)
						if back and not danger(back, cfg.Margin + 6, true, 2) then
							tp(back)
							D.origin = nil
						elseif now - D.lastDodge > 6 then
							D.origin = nil
						end
					end
				else
					D.origin = nil
				end
			end
		end
		stepRef = step

		-- boss starts an attack animation while you are in melee reach -> leave before the hit lands
		onBossAttack = function(m, nm)
			if not cfg.Dodge then return end
			pushSignal("ANIM:" .. tostring(nm))
			if not cfg.AnimDodge then return end
			local _, hrp = getChar()
			local c = posOf(m)
			if not hrp or not c then return end
			local reach = unitR(m) + 14
			if flat(hrp.Position, c) <= reach + cfg.Margin then
				addZone(c, reach, 1)
				note(string.format("ANIM %s '%s' reach=%.0f", m.Name, nm, reach))
				pcall(step, 0)
			end
		end

		pushSignalRef = pushSignal

		------------ boss events: tables that carry a position + radius become zones before anything is drawn
		local function scanArgs(t, depth, hrpPos)
			local pos, rad, delay
			for k, v in pairs(t) do
				local tv = typeof(v)
				if tv == "Vector3" then
					if not pos and (v - hrpPos).Magnitude < 500 then pos = v end
				elseif tv == "CFrame" then
					if not pos and (v.Position - hrpPos).Magnitude < 500 then pos = v.Position end
				elseif tv == "number" and type(k) == "string" then
					local lk = string.lower(k)
					if lk == "r" or hasAny(lk, RAD_HINT) then
						if v >= 3 and v <= 400 then rad = v end
					elseif hasAny(lk, TIME_HINT) and v > 0 and v <= 6 then
						delay = v
					end
				elseif tv == "table" and depth < 3 then
					scanArgs(v, depth + 1, hrpPos)
				end
			end
			if pos and rad then
				addZone(pos, rad, (delay or 1) + 1.5)
				note(string.format("EVT zone r=%.0f at (%.0f,%.0f,%.0f)", rad, pos.X, pos.Y, pos.Z))
			end
		end

		for _, nm in ipairs(CAST_EVENTS) do
			local ev = RS:FindFirstChild(nm, true)
			if ev and (ev:IsA("RemoteEvent") or ev:IsA("UnreliableRemoteEvent")) then
				local times, logAt = {}, -100
				track(ev.OnClientEvent:Connect(function(...)
					if not cfg.Dodge then return end
					local now = os.clock()
					times[#times + 1] = now
					while times[1] and now - times[1] > 2 do table.remove(times, 1) end
					local stream = #times > 6 -- fires constantly (hp sync etc.): not a cast signal
					local a = table.pack(...)
					if not stream then
						D.lastCast = now
						local tag = (type(a[1]) == "string" and #a[1] < 40) and (":" .. a[1]) or ""
						pushSignal((nm == "AHE_BossUlt" and "ULT" or ("CAST:" .. nm)) .. tag)
					end
					if cfg.WideDetect then
						local _, hrp = getChar()
						if hrp then pcall(scanArgs, a, 1, hrp.Position) end
					end
					if D.combat and now - logAt > (stream and 5 or 0.3) then
						logAt = now
						local out = {}
						for i = 1, math.min(a.n, 6) do out[#out + 1] = ser(a[i]) end
						note("CAST " .. nm .. " " .. table.concat(out, " | "))
					end
				end))
			end
		end

