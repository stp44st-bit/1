	-- never touch the end dialog (replay / home) or other menus that happen to open at the same moment
	local function isDialog(p)
		for _, d in ipairs(p:GetDescendants()) do
			if d:IsA("GuiButton") then
				local t = btnText(d)
				if hasWord(t, REPLAY_WORDS) or hasWord(t, { "home", "lobby", "leave", "exit", "quit" }) or hasWord(t, POPUP_SKIP) then return true end
			end
		end
		return false
	end

	local function closePanel(p, why)
		if isDialog(p) then return nil end
		-- 1) its own buttons (claim-looking first)
		local btns, first = {}, {}
		for _, d in ipairs(p:GetDescendants()) do
			if d:IsA("GuiButton") and shown(d) then
				local t = btnText(d)
				if not hasWord(t, REPLAY_WORDS) and not hasWord(t, POPUP_SKIP) then
					if hasWord(t, CLAIM_WORDS) then first[#first + 1] = d else btns[#btns + 1] = d end
				end
			end
		end
		if p:IsA("GuiButton") then btns[#btns + 1] = p end
		for _, b in ipairs(btns) do first[#first + 1] = b end
		for i = 1, math.min(#first, 3) do
			if not (p.Parent and shown(p)) then break end
			local okP, res = pcall(pressUntilGone, first[i], "popup " .. first[i].Name, function() return not (p.Parent and shown(p)) end)
			if okP and res then return "button " .. first[i].Name .. " (" .. res .. ")" end
		end
		-- 2) no button / buttons did nothing: a click on the popup itself (popups that close on any click)
		if p.Parent and shown(p) and cfg.VClick and VIM then
			local ap, as = p.AbsolutePosition, p.AbsoluteSize
			local x, y = ap.X + as.X / 2, ap.Y + as.Y / 2 + guiInsetFor(p)
			pcall(function()
				VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
				task.wait(0.05)
				VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
			end)
			task.wait(1.2)
			if not (p.Parent and shown(p)) then return "virtual click on the popup" end
		end
		-- 3) still there: hide it on your screen (the reward is already given by the server event)
		if p.Parent and shown(p) and cfg.HidePopup then
			p.Visible = false
			note("hid popup " .. p:GetFullName())
			return "hidden"
		end
		return nil
	end

	local popupBusy = false
	local function handlePopupEvent(t0)
		if popupBusy or not cfg.AutoClaim then return end
		popupBusy = true
		task.wait(0.7 + cfg.ClaimDelay)
		local before
		for i = #snaps, 1, -1 do
			if snaps[i].t < t0 - 0.05 then before = snaps[i].set break end
		end
		local now = panelsShown()
		local fresh = {}
		for p in pairs(now) do
			if not (before and before[p]) then
				-- keep the outermost new panel only
				local par = p.Parent
				if not (now[par] and not (before and before[par])) then fresh[#fresh + 1] = p end
			end
		end
		if #fresh == 0 then
			rep.claimWhy = "reward event, but nothing new appeared on screen"
			note(rep.claimWhy)
		end
		for i = #fresh, 1, -1 do
			if isDialog(fresh[i]) then table.remove(fresh, i) end
		end
		for _, p in ipairs(fresh) do
			L.popupPaths[table.concat(pathOf(p), "/")] = true
			note("popup panel: " .. p:GetFullName())
			while userBusy() and running do task.wait(0.3) end
			local res = closePanel(p)
			if res then
				stat.claims = stat.claims + 1
				rep.claimWhy = "popup closed: " .. res
			else
				rep.claimWhy = "popup " .. p.Name .. " could not be closed (see log)"
			end
			status = rep.claimWhy
		end
		popupBusy = false
	end
	env.MilkHatch_PopupEvent = function() task.spawn(handlePopupEvent, os.clock()) end

	-- panels already known as popups: closed whenever they show up again, even without the event
	task.spawn(function()
		while running do
			if cfg.AutoClaim and not popupBusy and next(L.popupPaths) then
				local pg = LP:FindFirstChildOfClass("PlayerGui")
				for key in pairs(L.popupPaths) do
					local o = pg
					for n in string.gmatch(key, "[^/]+") do
						o = o and o:FindFirstChild(n)
					end
					if o and o ~= pg and o:IsA("GuiObject") and shown(o) and not userBusy() then
						popupBusy = true
						local res = closePanel(o)
						popupBusy = false
						if res then
							stat.claims = stat.claims + 1
							rep.claimWhy = "popup closed: " .. res
						end
					end
				end
			end
			task.wait(0.8)
		end
	end)

	---------------- dropped items in the world (AHE_DroppedEggs etc.): collected through their prompt / click / touch
	local DROP_FOLDERS = { AHE_DroppedEggs = true }
	local function collectDrop(it)
		task.wait(0.3)
		if not (running and cfg.AutoClaim and cfg.PickDrops and it.Parent) then return end
		local _, hrp = getChar()
		if not hrp then return end
		local p = posOf(it)
		local back = hrp.CFrame
		local moved = false
		if p and (p - hrp.Position).Magnitude > 8 and not D.float then
			tp(p + Vector3.new(0, 3, 0))
			moved = true
			task.wait(0.15)
		end
		local how = {}
		for _, d in ipairs(it:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				pcall(function() d.HoldDuration = 0 d.RequiresLineOfSight = false end)
				if fireproximityprompt and pcall(fireproximityprompt, d) then how[#how + 1] = "prompt" end
			elseif d:IsA("ClickDetector") then
				if fireclickdetector and pcall(fireclickdetector, d) then how[#how + 1] = "click detector" end
			elseif d:IsA("TouchTransmitter") and d.Parent and firetouchinterest then
				pcall(firetouchinterest, hrp, d.Parent, 0)
				pcall(firetouchinterest, hrp, d.Parent, 1)
				how[#how + 1] = "touch"
			end
		end
		task.wait(0.5)
		note(string.format("drop %s: %s -> %s", it:GetFullName(), #how > 0 and table.concat(how, ",") or "nothing to press",
			it.Parent and "still there" or "collected"))
		if not it.Parent then stat.claims = stat.claims + 1 rep.claimWhy = "picked up " .. it.Name end
		if moved and not D.float then
			local _, h2 = getChar()
			if h2 then h2.CFrame = back end
		end
	end
	local function watchDrops(f)
		track(f.ChildAdded:Connect(function(it) task.spawn(collectDrop, it) end))
		for _, it in ipairs(f:GetChildren()) do task.spawn(collectDrop, it) end
	end
	for n in pairs(DROP_FOLDERS) do
		local f = Workspace:FindFirstChild(n)
		if f then watchDrops(f) end
	end
	track(Workspace.ChildAdded:Connect(function(c)
		if DROP_FOLDERS[c.Name] then watchDrops(c) end
	end))

	task.spawn(function()
		while running do
			if cfg.AutoClaim then pcall(autoClaim, "poll") end
			task.wait(0.6 + cfg.ClaimDelay)
		end
	end)

