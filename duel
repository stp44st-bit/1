local function SetupHotkeys()
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.F1 then
            Settings.ESP = not Settings.ESP
            print("[Z3R0] ESP:", Settings.ESP and "ON" or "OFF")
        elseif input.KeyCode == Enum.KeyCode.F2 then
            Settings.Aimbot = not Settings.Aimbot
            print("[Z3R0] Aimbot:", Settings.Aimbot and "ON" or "OFF")
        elseif input.KeyCode == Enum.KeyCode.F3 then
            Settings.AutoFarm = not Settings.AutoFarm
            print("[Z3R0] AutoFarm:", Settings.AutoFarm and "ON" or "OFF")
        elseif input.KeyCode == Enum.KeyCode.F4 then
            Settings.SpeedHack = not Settings.SpeedHack
            print("[Z3R0] SpeedHack:", Settings.SpeedHack and "ON" or "OFF")
        elseif input.KeyCode == Enum.KeyCode.F5 then
            Settings.Noclip = not Settings.Noclip
            print("[Z3R0] Noclip:", Settings.Noclip and "ON" or "OFF")
        elseif input.KeyCode == Enum.KeyCode.F6 then
            Settings.Fly = not Settings.Fly
            print("[Z3R0] Fly:", Settings.Fly and "ON" or "OFF")
        elseif input.KeyCode == Enum.KeyCode.R and Settings.Teleport then
            local target = GetClosestPlayer()
            if target and target.Character then
                local root = target.Character:FindFirstChild("HumanoidRootPart")
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root and myRoot then
                    myRoot.CFrame = root.CFrame + Vector3.new(0, 5, 0)
                    print("[Z3R0] Teleported to:", target.Name)
                end
            end
        end
    end)
end

