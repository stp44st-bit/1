            local nameLabel = Instance.new("TextLabel", billboard)
            nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
            nameLabel.Position = UDim2.new(0, 0, 0.5, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = player.Name
            nameLabel.TextColor3 = Settings.ESPColor or Color3.new(0, 1, 0)
            nameLabel.TextScaled = true
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextStrokeTransparency = 0.3
            objects.nameLabel = nameLabel
        end
        
        if Settings.ShowHealth then
            local healthLabel = Instance.new("TextLabel", billboard)
            healthLabel.Size = UDim2.new(1, 0, 0.3, 0)
            healthLabel.Position = UDim2.new(0, 0, 0, 0)
            healthLabel.BackgroundTransparency = 1
            healthLabel.Text = "❤️ 100%"
            healthLabel.TextColor3 = Color3.new(0, 1, 0)
            healthLabel.TextScaled = true
            healthLabel.Font = Enum.Font.Gotham
            objects.healthLabel = healthLabel
        end
        
        if Settings.ShowDistance then
            local distLabel = Instance.new("TextLabel", billboard)
            distLabel.Size = UDim2.new(1, 0, 0.3, 0)
            distLabel.Position = UDim2.new(0, 0, 0.85, 0)
            distLabel.BackgroundTransparency = 1
            distLabel.Text = "0m"
            distLabel.TextColor3 = Color3.new(1, 1, 1)
            distLabel.TextScaled = true
            distLabel.Font = Enum.Font.Gotham
            objects.distLabel = distLabel
        end
        
        objects.billboard = billboard
    end
    
    -- Tracer
    if Settings.ShowTracers then
        local tracer = Instance.new("LineHandleAdornment")
        tracer.Adornee = root
        tracer.AlwaysOnTop = true
        tracer.Color3 = Settings.ESPColor or Color3.new(0, 1, 0)
        tracer.Thickness = 2
        tracer.Transparency = 0.4
        tracer.PointA = Vector3.new(0, 0, 0)
        tracer.PointB = Vector3.new(0, 5, 0)
        tracer.Parent = root
        objects.tracer = tracer
    end
    
    ESPObjects[player] = objects
end

local function UpdateESP()
    local myTeam = GetTeam(LocalPlayer)
    
    for player, objects in pairs(ESPObjects) do
        if not IsValid(player) then
            for _, obj in pairs(objects) do
                pcall(function() obj:Destroy() end)
            end
            ESPObjects[player] = nil
        else
            local color = Settings.ESPColor or Color3.new(0, 1, 0)
            local playerTeam = GetTeam(player)
            
            if Settings.TeamCheck and playerTeam == myTeam then
                color = Color3.new(0, 0.5, 1) -- Team color
            elseif Settings.TeamCheck then
                color = Color3.new(1, 0, 0) -- Enemy color
            end
            
            -- Update color
            for _, obj in pairs(objects) do
                if obj:IsA("HandleAdornment") and obj ~= objects.border then
                    obj.Color3 = color
                end
                if obj:IsA("TextLabel") and obj ~= objects.healthLabel and obj ~= objects.distLabel then
                    obj.TextColor3 = color
                end
            end
            
            -- Update health
            if objects.healthLabel then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid then
                    local health = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
                    objects.healthLabel.Text = string.format("❤️ %d%%", health)
                    if health > 70 then
                        objects.healthLabel.TextColor3 = Color3.new(0, 1, 0)
                    elseif health > 35 then
                        objects.healthLabel.TextColor3 = Color3.new(1, 1, 0)
                    else
                        objects.healthLabel.TextColor3 = Color3.new(1, 0, 0)
                    end
                end
            end
            
            -- Update distance
            if objects.distLabel then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root and myRoot then
                    local dist = (root.Position - myRoot.Position).Magnitude
                    objects.distLabel.Text = string.format("%.1fm", dist)
                end
            end
        end
    end
end

